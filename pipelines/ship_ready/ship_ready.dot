// ship_ready.dot
//
// A pipeline with two jobs, dispatched from one graph based on how it was
// invoked:
//
//   1. BOOTSTRAP MODE (no GitHub event context -- e.g. run once manually
//      against a repo, or by idea_to_pr / a human setting up a
//      new project): ensure a `.github/workflows/deploy.yml` exists and is
//      configured to (a) deploy a Vercel PREVIEW + comment its URL on every
//      pull_request, and (b) deploy to Vercel PROD + run Supabase
//      migrations on every push to the default branch. Writes/commits the
//      workflow file if missing or stale; no-ops if already present and
//      current.
//
//   2. RUNTIME MODE (invoked BY that generated GitHub Actions workflow,
//      i.e. $github_event_name is set): actually perform the deploy for
//      the event that fired -- pull_request -> Vercel preview + comment,
//      push -> Vercel prod + supabase db push, each followed by a
//      curl-poll-with-backoff liveness check before declaring success.
//
// This is intentionally ONE graph, not two: GitHub Actions' own `on:`
// trigger fan-out already lives in the generated workflow YAML (two
// triggers -> same pipeline invocation, differing only in
// $github_event_name), so branching inside this graph via a single router
// node keeps one unified goal-gate/report surface instead of duplicating
// it across two DOT files.
//
// TOGETHER WITH THE OTHER TWO PIPELINES IN THIS REPO:
//   idea_to_pr  -- opens a PR
//   pr_review        -- posts a fast automated review on that PR
//   ship_ready (this one) -- the PR's own GitHub Actions run gives it a
//                            live Vercel preview; merging to main triggers
//                            a real Vercel prod deploy + Supabase migration
//
// Liveness verification uses a bash curl-poll-with-backoff loop INSIDE a
// tool_command node, not multiple graph-level LLM retries -- an LLM
// round-trip per poll attempt is wasteful; a shell loop with sleep+backoff
// is transparent, inspectable, and free.
//
// Context inputs:
//   $repo               - target repo slug (owner/name)
//   $github_event_name  - "pull_request" | "push" | unset (bootstrap mode)
//   $pr_url             - PR URL, required when $github_event_name=pull_request
//                         (used only to post the preview-url comment)
//
// Context outputs:
//   workflow.result      - "written" | "already_current" (bootstrap mode)
//   deploy.preview_url    - Vercel preview URL (pull_request mode)
//   deploy.preview_live   - "true" | "false"
//   deploy.prod_url       - Vercel prod URL (push mode)
//   deploy.prod_live      - "true" | "false"
//   deploy.migration_result - "applied" | "failed" (push mode)

digraph ship_ready {
  graph [
    label="Ship Ready -- CI/CD bootstrap + Vercel/Supabase deploy",
    goal="$repo",
    rankdir=LR,
    default_max_retry=2,
    default_fidelity="summary:high",
    model_stylesheet="* { llm_model: claude-sonnet-4-6; llm_provider: anthropic; }"
  ];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  // --- Router: bootstrap (no GH event) vs. runtime (PR or push event) ---
  DetectMode [
    shape=parallelogram, label="Detect Invocation Mode",
    tool_command="bash -c 'ev=${GITHUB_EVENT_NAME:-$github_event_name}; if [ -z \"$ev\" ]; then echo bootstrap; else echo \"$ev\"; fi'"
  ];

  // ═══════════════════ BOOTSTRAP BRANCH ═══════════════════
  //
  // Idempotent: a stable marker comment inside the generated workflow file
  // lets re-runs tell "file exists and matches our template" apart from
  // "file exists but is stale/hand-edited" -- grep the marker, not just -f.
  CheckWorkflow [
    shape=parallelogram, label="Check Workflow Exists",
    tool_command="bash -c 'if [ -f .github/workflows/deploy.yml ] && grep -q ship_ready-marker-v1 .github/workflows/deploy.yml; then echo current; else echo missing; fi'"
  ];

  WriteWorkflow [
    shape=box, goal_gate=true, fidelity="summary:high",
    label="Write CI/CD Workflow",
    prompt="Write .github/workflows/deploy.yml with exactly two jobs: (1) a `pull_request` job that runs `vercel deploy --token=$${VERCEL_TOKEN} --yes` (using the vercel-action or plain CLI), captures the preview URL, and comments it on the PR via the GitHub API; (2) a `push` job restricted to the default branch that runs `vercel deploy --prod --token=$${VERCEL_TOKEN} --yes` followed by `supabase db push --db-url $${SUPABASE_DB_URL} --yes`. Both jobs should invoke this same repo's ship_ready pipeline (git+https://github.com/kenotron-ms/attractor-pipelines@main#subdirectory=pipelines/ship_ready/ship_ready.dot) as the actual deploy runner, passing through GITHUB_EVENT_NAME and the required secrets (VERCEL_TOKEN, SUPABASE_DB_URL, GH_TOKEN) as env vars -- do not duplicate the deploy logic directly in YAML shell steps. Required repo secrets: VERCEL_TOKEN, SUPABASE_DB_URL, ANTHROPIC_API_KEY, GH_TOKEN. Include the literal comment '# ship_ready-marker-v1' somewhere in the file so future idempotency checks can detect this exact template version. Print the single line: workflow_written"
  ];

  CommitWorkflow [
    shape=box, goal_gate=true, fidelity="summary:high",
    label="Commit Workflow",
    prompt="Stage .github/workflows/deploy.yml, commit with message 'ci: add ship_ready deploy workflow (Vercel preview/prod + Supabase migrations)', and push to the current branch. Print the single line: workflow_committed"
  ];

  BootstrapReport [
    shape=box, goal_gate=true, fidelity="summary:high",
    label="Bootstrap Report",
    prompt="Report the bootstrap outcome: was .github/workflows/deploy.yml already current, or did this run write and commit it? Remind the human which secrets must be set on the repo (VERCEL_TOKEN, SUPABASE_DB_URL, ANTHROPIC_API_KEY, GH_TOKEN) if it was just written. Print the single line: bootstrap_reported"
  ];

  // ═══════════════════ PULL_REQUEST BRANCH ═══════════════════
  DeployVercelPreview [
    shape=parallelogram, label="Vercel Preview Deploy",
    tool_command="#!/bin/sh\nset -e\nurl=$(vercel deploy --token=$VERCEL_TOKEN --yes 2>&1 | tail -1)\nprintf '{\"deploy.preview_url\": \"%s\"}' \"$url\"",
    parse_json="true", timeout="5m"
  ];

  // Liveness check lives IN the tool_command's own shell loop, not as
  // repeated graph-level LLM retries -- cheap, transparent, no wasted
  // API round trips waiting on deploy propagation.
  VerifyPreviewLive [
    shape=parallelogram, label="Verify Preview Live",
    tool_command="#!/bin/sh\nset -e\nurl=\"$deploy_preview_url\"\nok=false\nfor i in 1 2 3 4 5; do\n  if curl -sf -o /dev/null \"$url\"; then ok=true; break; fi\n  sleep $((3 * i))\ndone\nprintf '{\"deploy.preview_live\": \"%s\"}' \"$ok\"",
    parse_json="true", timeout="3m"
  ];

  CommentPreviewUrl [
    shape=box, goal_gate=true, fidelity="summary:high",
    label="Comment Preview URL on PR",
    prompt="Post a comment on $pr_url via bash + curl (GH_TOKEN from env) with the deployed preview URL: ${deploy.preview_url}. If ${deploy.preview_live} is false, say the deploy is up but did not respond to a liveness check within 5 attempts and flag it for manual verification -- do not claim it's live if it isn't. Print the single line: preview_commented"
  ];

  PreviewReport [
    shape=box, goal_gate=true, fidelity="summary:high",
    label="Preview Report",
    prompt="Summarize the preview deploy: URL ${deploy.preview_url}, live=${deploy.preview_live}. Print the single line: preview_reported"
  ];

  // ═══════════════════ PUSH (default-branch) BRANCH ═══════════════════
  DeployVercelProd [
    shape=parallelogram, label="Vercel Prod Deploy",
    tool_command="#!/bin/sh\nset -e\nurl=$(vercel deploy --prod --token=$VERCEL_TOKEN --yes 2>&1 | tail -1)\nprintf '{\"deploy.prod_url\": \"%s\"}' \"$url\"",
    parse_json="true", timeout="6m"
  ];

  SupabaseMigrate [
    shape=parallelogram, label="Supabase DB Push",
    tool_command="#!/bin/sh\nif supabase db push --db-url \"$SUPABASE_DB_URL\" --yes; then printf '{\"deploy.migration_result\": \"applied\"}'; else printf '{\"deploy.migration_result\": \"failed\"}'; fi",
    parse_json="true", timeout="5m"
  ];

  VerifyProdLive [
    shape=parallelogram, label="Verify Prod Live",
    tool_command="#!/bin/sh\nset -e\nurl=\"$deploy_prod_url\"\nok=false\nfor i in 1 2 3 4 5; do\n  if curl -sf -o /dev/null \"$url\"; then ok=true; break; fi\n  sleep $((3 * i))\ndone\nprintf '{\"deploy.prod_live\": \"%s\"}' \"$ok\"",
    parse_json="true", timeout="3m"
  ];

  ProdReport [
    shape=box, goal_gate=true, fidelity="summary:high",
    label="Prod Report",
    prompt="Summarize the prod deploy: URL ${deploy.prod_url}, live=${deploy.prod_live}, migration result=${deploy.migration_result}. If migration_result is failed, or prod_live is false, say so plainly and flag for immediate human attention -- do not report success. Print the single line: prod_reported"
  ];

  Start      -> DetectMode;
  DetectMode -> CheckWorkflow         [condition="context.tool.last_line=bootstrap",     weight="2"];
  DetectMode -> DeployVercelPreview   [condition="context.tool.last_line=pull_request"];
  DetectMode -> DeployVercelProd      [condition="context.tool.last_line=push"];

  CheckWorkflow -> WriteWorkflow      [condition="context.tool.last_line=missing"];
  CheckWorkflow -> BootstrapReport    [condition="context.tool.last_line=current", weight="2"];
  WriteWorkflow -> CommitWorkflow;
  CommitWorkflow -> BootstrapReport;
  BootstrapReport -> Exit;

  DeployVercelPreview -> VerifyPreviewLive;
  VerifyPreviewLive   -> CommentPreviewUrl;
  CommentPreviewUrl   -> PreviewReport;
  PreviewReport        -> Exit;

  DeployVercelProd -> SupabaseMigrate;
  SupabaseMigrate  -> VerifyProdLive;
  VerifyProdLive   -> ProdReport;
  ProdReport        -> Exit;
}
