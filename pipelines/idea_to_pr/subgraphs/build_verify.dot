// build_verify.dot
//
// The lite counterpart to idea_to_shipped/subgraphs/build_loop.dot: one
// Implement step, judged by an independent SelfEvaluate step against a
// WEIGHTED, user-facing rubric -- not a bare round count and not a bare
// pass/fail self-report.
//
// RUBRIC METHODOLOGY: follows
// https://github.com/microsoft/amplifier-bundle-evaluation/blob/main/context/methodology/rubric-design.md
// -- a rubric is a flat set of named criteria, each with a point value
// (relative weight) and an OBSERVABLE question, scored by a judge that
// gathers real evidence first. The floor has moved: modern agents rarely
// ship visibly broken output, so a rubric that only checks "did the file
// get written" or "did the command exit 0" has nothing left to say about
// the gap between technically-works and actually-good. Criteria here are
// written and judged from a USER's vantage point -- would someone using
// this feature get what they came for? -- not an engineer's checklist.
//
// WHY RUBRIC-DRIVEN, NOT ROUND-DRIVEN: a fix loop that just counts
// attempts ("try up to N times") has no relationship to whether the work
// is actually done -- it either stops too early or "passes" on a
// technicality. The actual exit condition here is: the weighted score
// across every rubric criterion clears rubric.json's pass_threshold, as
// judged against real evidence gathered per rubric.json's "steps". Points
// aren't pass/fail per criterion -- SelfEvaluate awards partial credit
// where the rubric's description says partial credit is available, same
// as a human grading a rubric would.
//
// The round counter (CheckFixRounds) still exists, but ONLY as a safety
// backstop against a genuinely non-convergent loop -- it is not the
// mechanism that decides "good enough." If the backstop trips, the
// pipeline reports FAILURE honestly (build.verdict=escalated) rather than
// silently declaring success. It is an explicit context counter, NOT
// max_retries -- max_retries only bounds a single node's own execution
// attempts (e.g. transient LLM errors), it does not limit how many times
// the graph loops back through an edge.
//
// A "loop" here means one full Implement -> SelfEvaluate -> Fix ->
// SelfEvaluate cycle -- NOT a conversational turn (a single loop can span
// many turns). The parent's Plan phase is required to write rubric
// criteria narrow enough that a well-formed task typically clears its
// full points on loop 1, and worst-case converges by loop 2 (one Fix
// pass). If this backstop is regularly tripping, that's a signal the
// RUBRIC/TASKS were too loose or too broad going in -- fix the plan's
// task decomposition, don't just raise $max_fix_rounds to paper over it.
//
// RUBRIC CONTRACT (written by the parent's Plan node to
// .resolve/plan/rubric.json, read by both Implement and SelfEvaluate):
//   {
//     "steps": "<ordered evidence-gathering plan -- what to run, read, or
//               actually try as a user before judging any criterion,
//               referencing the VDD tier commands from the plan doc>",
//     "pass_threshold": 0.85,
//     "criteria": {
//       "<snake_case_name>": {
//         "points": <int>,
//         "task": <N, or null for an overall/cross-cutting criterion>,
//         "description": "<observable, user-facing question -- prefixed
//                          with 'CRITICAL:' for the 2-3 heavy-weighted
//                          criteria that actually separate good work from
//                          competent-looking-but-shallow work>"
//       },
//       ...
//     }
//   }
//
// SelfEvaluate scores each criterion 0..points (partial credit per the
// description's own rules, not an invented scale), sums points_awarded /
// total points across all criteria, and compares against pass_threshold.
//
// Required context variables (injected by parent via graph attrs / $vars):
//   $max_fix_rounds  - safety-backstop cap on fix iterations (default 2).
//                      This is NOT how completion is decided -- weighted
//                      rubric achievement is. A tightly-planned task
//                      should clear its full points within 1-2 loops; 2
//                      gives exactly one Fix pass of headroom beyond the
//                      first attempt before escalating, rather than a
//                      large arbitrary budget that masks an over-broad
//                      task/criterion.
//
// Context outputs (declared via `outputs=` on the folder node in the parent):
//   build.verdict          - final "rubric_met" | "escalated"
//   build.fix_rounds_used  - integer count of fix rounds consumed
//   build.rubric_result    - path to the final .resolve/verify/rubric_result.json
//   build.rubric_score     - final weighted score achieved, 0.0-1.0

digraph build_verify {
  graph [rankdir=LR, default_max_retry=2, default_fidelity="summary:high"];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  // Implements the plan's tasks and gathers the evidence rubric.json's
  // "steps" call for, but does NOT self-declare pass/fail or award its own
  // points -- that judgment belongs entirely to the independent
  // SelfEvaluate step below, which doesn't trust Implement's own account.
  Implement [
    shape=box, goal_gate=true, fidelity="full",
    label="Implement",
    prompt="Read docs/plans/<date>-<feature>-implementation.md and .resolve/plan/rubric.json (including its 'steps' evidence plan). For EACH task not yet marked complete, in order: (1) run static analysis FIRST and fix any pre-existing issues; (2) implement exactly what's specified -- no extra features, no 'while I'm here' improvements; (3) run static analysis again; (4) run the VDD verification command the plan assigned this task's tier (unit test / jsdom+node integration test / real browser -- do NOT substitute a cheaper check, and do NOT reach for a browser if the plan's tier is unit or jsdom). Also actually exercise the feature the way rubric.json's 'steps' describes for this task's criteria -- if a criterion is about what a user would experience, go look at or try that, don't infer it from the code. Document the ACTUAL output/behavior you saw verbatim -- do not summarize or paraphrase it. (5) Commit atomically: 'feat: [what this does]'. Append your result to docs/plans/<feature>-status.md under this task's heading with the exact static-analysis output, the exact verification command + output, and what you observed when exercising the feature per the rubric's steps. After all tasks are attempted, also work through rubric.json's overall 'steps' (e.g. full test suite, static analysis clean, any cross-cutting user-facing check) and document that output too. Do NOT self-score against the rubric and do NOT declare victory -- just report what you did and what actually happened. Print the single line: implement_done"
  ];

  // The judge. Adversarial and independent: gathers/re-gathers evidence
  // per rubric.json's "steps", then scores EVERY criterion against that
  // evidence -- never against Implement's status write-up alone. Thinks
  // like a user experiencing the result, not an engineer confirming a
  // command exited 0.
  SelfEvaluate [
    shape=box, goal_gate=true, fidelity="full",
    label="Self-Evaluate (judge, weighted rubric)",
    prompt="Read .resolve/plan/rubric.json in full (its 'steps', 'pass_threshold', and every criterion) and docs/plans/<feature>-status.md. First, work through rubric.json's 'steps' yourself right now -- re-run commands, read the actual files, and where a criterion is about user-facing behavior, actually use the feature the way a real user would rather than reading the code and assuming. If status.md's account looks incomplete, inconsistent, or suspiciously clean anywhere, that is exactly when to re-verify directly rather than trust it. Then, for EACH criterion in rubric.json: think like a user, not an engineer -- award points_awarded from 0 up to that criterion's max points based on what the evidence actually shows, using any partial-credit rule stated in the criterion's own description (do not invent your own scale). A 'CRITICAL:' criterion failing should cost real points, not a token deduction. Do not award points for something merely claimed in status.md without evidence backing it. Do not invent criteria that aren't in rubric.json, and do not skip any that are. Compute overall_score = sum(points_awarded) / sum(points) across all criteria. Write .resolve/verify/rubric_result.json: {\\\"overall_score\\\": <float 0-1>, \\\"pass_threshold\\\": <copied from rubric.json>, \\\"results\\\": [{\\\"id\\\": \\\"<criterion id>\\\", \\\"points\\\": <max>, \\\"points_awarded\\\": <awarded>, \\\"reasoning\\\": \\\"<what evidence you checked and why this many points>\\\"}, ...]}. Print the single line: rubric_verdict=pass if overall_score >= pass_threshold, or rubric_verdict=fail otherwise, followed on the next line by rubric_score=<overall_score>."
  ];

  CheckRubric [
    shape=parallelogram, label="Check Rubric Verdict",
    tool_command="bash -c 'if echo \"$last_response\" | grep -q rubric_verdict=pass; then echo pass; else echo fail; fi'"
  ];

  // Safety backstop ONLY -- not the completion mechanism. Default 2
  // matches the "typically 1-2 loops per task" expectation a tight,
  // well-weighted rubric should produce: attempt 1 (Implement's own
  // pass), then at most one Fix pass. If the rubric was scoped correctly,
  // this rarely trips; if it trips often, the fix is tighter task/rubric
  // decomposition in Plan, not a larger number here.
  CheckFixRounds [
    shape=parallelogram, label="Check Fix Rounds (safety backstop)",
    tool_command="#!/bin/sh\nset -e\nmkdir -p .resolve\ncount=$(python3 -c \"import json,os;p='.resolve/fix_state.json';d=json.load(open(p)) if os.path.exists(p) else {'count':0};d['count']+=1;json.dump(d,open(p,'w'));print(d['count'])\")\nmax=${max_fix_rounds:-2}\nif [ \"$count\" -le \"$max\" ]; then printf 'fix_ok'; else printf 'fix_exhausted'; fi"
  ];

  Fix [
    shape=box, goal_gate=true, fidelity="full",
    label="Fix (address lowest-scoring rubric criteria)",
    prompt="Read .resolve/verify/rubric_result.json. Prioritize any criterion whose description was marked 'CRITICAL:' and scored below full points, then work through the rest by largest points-lost (points - points_awarded). For each, fix the SPECIFIC gap the reasoning field points to -- no broad rewrite, address exactly what's short. Re-run that criterion's evidence per rubric.json's 'steps' and confirm the fresh result actually earns more points before moving to the next one. Update docs/plans/<feature>-status.md with what changed and the fresh evidence. Print the single line: fix_attempted"
  ];

// Split into two literal-outcome nodes rather than one shared node that
  // relies on a positional "$1" shell argument -- nothing in this graph
  // ever passes an argument into a bare tool_command invocation, so that
  // argument would always be empty, making build.verdict always "" and
  // guaranteeing "no matching edge" in the parent graph on EVERY run,
  // regardless of whether the rubric actually passed or the backstop
  // tripped. Each node below hard-codes its own literal verdict instead
  // and computes the shared rubric_score itself.
  ExtractVerdictMet [
    shape=parallelogram, label="Extract Verdict (rubric met)",
    tool_command="#!/bin/sh\nset -e\ncount=$(python3 -c \"import json,os;p='.resolve/fix_state.json';print(json.load(open(p))['count'] if os.path.exists(p) else 0)\")\nscore=$(python3 -c \"import json,os;p='.resolve/verify/rubric_result.json';print(json.load(open(p)).get('overall_score', 0) if os.path.exists(p) else 0)\")\nprintf '{\"build.verdict\": \"rubric_met\", \"build.fix_rounds_used\": %s, \"build.rubric_result\": \".resolve/verify/rubric_result.json\", \"build.rubric_score\": %s}' \"$count\" \"$score\"",
    parse_json="true"
  ];

  ExtractVerdictEscalated [
    shape=parallelogram, label="Extract Verdict (escalated)",
    tool_command="#!/bin/sh\nset -e\ncount=$(python3 -c \"import json,os;p='.resolve/fix_state.json';print(json.load(open(p))['count'] if os.path.exists(p) else 0)\")\nscore=$(python3 -c \"import json,os;p='.resolve/verify/rubric_result.json';print(json.load(open(p)).get('overall_score', 0) if os.path.exists(p) else 0)\")\nprintf '{\"build.verdict\": \"escalated\", \"build.fix_rounds_used\": %s, \"build.rubric_result\": \".resolve/verify/rubric_result.json\", \"build.rubric_score\": %s}' \"$count\" \"$score\"",
    parse_json="true"
  ];

  Start          -> Implement;
  Implement      -> SelfEvaluate;
  SelfEvaluate   -> CheckRubric;
  CheckRubric    -> ExtractVerdictMet       [condition="context.tool.last_line=pass", weight="2", label="rubric met"];
  CheckRubric    -> CheckFixRounds          [condition="context.tool.last_line=fail", label="rubric unmet"];
  CheckFixRounds -> Fix                     [condition="context.tool.last_line=fix_ok",       label="fix round (backstop max $max_fix_rounds)"];
  CheckFixRounds -> ExtractVerdictEscalated [condition="context.tool.last_line=fix_exhausted", label="backstop tripped -- escalate"];
  Fix            -> SelfEvaluate            [loop_restart="true"];
  ExtractVerdictMet       -> Exit;
  ExtractVerdictEscalated -> Exit;
}
