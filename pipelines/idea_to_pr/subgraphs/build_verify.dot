// build_verify.dot
//
// The lite counterpart to idea_to_shipped/subgraphs/build_loop.dot: one
// combined Implement step (no separate implementer / verifier /
// quality-reviewer agents), gated by RUBRIC ACHIEVEMENT rather than a bare
// round count.
//
// WHY RUBRIC-DRIVEN, NOT ROUND-DRIVEN: a fix loop that just counts attempts
// ("try up to N times") has no relationship to whether the work is
// actually done -- it either stops too early (real problem, rounds
// exhausted) or "passes" on a technicality (self-report says pass because
// the LLM said so, not because it was checked against anything concrete).
// The actual exit condition here is: every criterion in the plan's rubric
// is independently checked against real evidence and confirmed met.
// SelfEvaluate is adversarial about this -- it does not trust Implement's
// own "done" claim, it re-examines the evidence against each rubric item.
//
// The round counter (CheckFixRounds) still exists, but ONLY as a safety
// backstop against a genuinely non-convergent loop -- it is not the
// mechanism that decides "good enough." If the backstop trips, the
// pipeline reports FAILURE honestly (build.verdict=escalated) rather than
// silently declaring success. It is an explicit context counter, NOT
// max_retries -- max_retries only bounds a single node's own execution
// attempts (e.g. transient LLM errors), it does not limit how many times
// the graph loops back through an edge.
//
// A "loop" here means one full Implement -> SelfEvaluate -> Fix ->
// SelfEvaluate cycle -- NOT a conversational turn (a single loop can span
// many turns). The parent's Plan phase is required to write rubric
// criteria narrow enough that a well-formed task typically clears the
// rubric on loop 1, and worst-case converges by loop 2 (one Fix pass). If
// this backstop is regularly tripping, that's a signal the RUBRIC/TASKS
// were too loose or too broad going in -- fix the plan's task
// decomposition, don't just raise $max_fix_rounds to paper over it.
//
// RUBRIC CONTRACT (written by the parent's Plan node to
// .resolve/plan/rubric.json, read by both Implement and SelfEvaluate):
//   {
//     "criteria": [
//       {"id": "task-1-verification", "task": 1,
//        "criterion": "<concrete, checkable statement -- e.g. 'unit test
//                       suite for parseConfig() passes: pytest
//                       tests/test_config.py'>",
//        "check": "<exact command to independently confirm it>"},
//       ...
//     ],
//     "overall": [
//       {"id": "static-analysis-clean",
//        "criterion": "No new static analysis warnings/errors introduced",
//        "check": "<exact command>"},
//       {"id": "no-regressions",
//        "criterion": "Full existing test suite still passes",
//        "check": "<exact command>"}
//     ]
//   }
//
// Verification Driven Development, three-tier hierarchy for what a rubric
// criterion's `check` command should actually run, in preference order:
//   1. Unit tests for LIBRARY code (pure functions, no DOM/network/process
//      boundary).
//   2. Lightweight jsdom + node test env for INTEGRATION tests (component
//      wiring, event handlers, state -- simulated DOM, no real browser).
//   3. Real browser verification (playwright-cli / browser-tester) ONLY
//      for the genuinely hardest-to-verify things: focus management,
//      accessibility, visual layout truth. The exception, not the default.
//
// Required context variables (injected by parent via graph attrs / $vars):
//   $max_fix_rounds  - safety-backstop cap on fix iterations (default 2).
//                      This is NOT how completion is decided -- rubric
//                      achievement is. A tightly-planned task should clear
//                      the rubric within 1-2 loops; 2 gives exactly one
//                      Fix pass of headroom beyond the first attempt
//                      before escalating, rather than a large arbitrary
//                      budget that masks an over-broad task/criterion.
//
// Context outputs (declared via `outputs=` on the folder node in the parent):
//   build.verdict          - final "rubric_met" | "escalated"
//   build.fix_rounds_used  - integer count of fix rounds consumed
//   build.rubric_result    - path to the final .resolve/verify/rubric_result.json

digraph build_verify {
  graph [rankdir=LR, default_max_retry=2, default_fidelity="summary:high"];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  // Implements the plan's tasks and runs each rubric criterion's `check`
  // command, but does NOT self-declare pass/fail -- that judgment belongs
  // to the independent SelfEvaluate step below, which doesn't trust
  // Implement's own account of what happened.
  Implement [
    shape=box, goal_gate=true, fidelity="full",
    label="Implement",
    prompt="Read docs/plans/<date>-<feature>-implementation.md and .resolve/plan/rubric.json. For EACH task not yet marked complete, in order: (1) run static analysis FIRST and fix any pre-existing issues; (2) implement exactly what's specified -- no extra features, no 'while I'm here' improvements; (3) run static analysis again; (4) run that task's rubric criterion `check` command from rubric.json (unit test / jsdom+node integration test / real browser -- do NOT substitute a cheaper check than the rubric specifies, and do NOT reach for a browser if the rubric's check is a unit or jsdom test). Document the ACTUAL command output verbatim -- do not summarize or paraphrase it. (5) Commit atomically: 'feat: [what this does]'. Append your result to docs/plans/<feature>-status.md under this task's heading with the exact static-analysis output and the exact rubric check command + its exact output. After all tasks are attempted, also run every `overall` rubric criterion's check command (e.g. full test suite, static analysis clean) and document its exact output too. Do NOT declare victory yourself -- just report what you did and what each command actually printed. Print the single line: implement_done"
  ];

  // Adversarial, independent evaluation against the rubric -- re-runs or
  // re-reads the evidence for EVERY criterion rather than trusting
  // Implement's status write-up. This is the real gate, not a round count.
  SelfEvaluate [
    shape=box, goal_gate=true, fidelity="full",
    label="Self-Evaluate Against Rubric",
    prompt="Read .resolve/plan/rubric.json (every task criterion + every overall criterion) and docs/plans/<feature>-status.md. For EACH criterion, independently verify it -- do not simply trust the status doc's claim. If the recorded command output looks incomplete, inconsistent, or suspiciously clean, RE-RUN the criterion's `check` command yourself right now and use that fresh output as ground truth. A criterion is 'met' only if its check command's actual output demonstrates the criterion, not because status.md says 'DONE'. Do not invent criteria that aren't in rubric.json, and do not skip any that are. Write .resolve/verify/rubric_result.json: {\"overall_verdict\": \"pass\"|\"fail\", \"results\": [{\"id\": \"<criterion id>\", \"met\": true|false, \"evidence\": \"<the actual command output or citation you checked>\"}, ...]}. Print the single line: rubric_verdict=pass if overall_verdict is pass, or rubric_verdict=fail if any criterion is unmet."
  ];

  CheckRubric [
    shape=parallelogram, label="Check Rubric Verdict",
    tool_command="bash -c 'if echo \"$last_response\" | grep -q rubric_verdict=pass; then echo pass; else echo fail; fi'"
  ];

  // Safety backstop ONLY -- not the completion mechanism. Default 2
  // matches the "typically 1-2 loops per task" expectation a tight rubric
  // should produce: attempt 1 (Implement's own pass), then at most one
  // Fix pass. If the rubric was scoped correctly, this rarely trips; if
  // it trips often, the fix is tighter task decomposition in Plan, not a
  // larger number here.
  CheckFixRounds [
    shape=parallelogram, label="Check Fix Rounds (safety backstop)",
    tool_command="#!/bin/sh\nset -e\nmkdir -p .resolve\ncount=$(python3 -c \"import json,os;p='.resolve/fix_state.json';d=json.load(open(p)) if os.path.exists(p) else {'count':0};d['count']+=1;json.dump(d,open(p,'w'));print(d['count'])\")\nmax=${max_fix_rounds:-2}\nif [ \"$count\" -le \"$max\" ]; then printf 'fix_ok'; else printf 'fix_exhausted'; fi"
  ];

  Fix [
    shape=box, goal_gate=true, fidelity="full",
    label="Fix (address unmet rubric criteria)",
    prompt="Read .resolve/verify/rubric_result.json. For EVERY criterion with met=false, fix the specific gap its evidence points to -- no broad rewrite, address exactly what's unmet. Re-run that criterion's check command directly and confirm the new output actually satisfies it before moving to the next unmet criterion. Update docs/plans/<feature>-status.md with what changed and the fresh command output. Print the single line: fix_attempted"
  ];

  // Split into two literal-outcome nodes rather than one shared node that
  // relied on a positional "$1" shell argument -- nothing in this graph
  // ever passed an argument into a bare tool_command invocation, so that
  // argument was always empty, making build.verdict always "" and
  // guaranteeing "no matching edge" in the parent graph on EVERY run,
  // regardless of whether the rubric actually passed or the backstop
  // tripped. Each node below hard-codes its own literal verdict instead.
  ExtractVerdictMet [
    shape=parallelogram, label="Extract Verdict (rubric met)",
    tool_command="#!/bin/sh\nset -e\ncount=$(python3 -c \"import json,os;p='.resolve/fix_state.json';print(json.load(open(p))['count'] if os.path.exists(p) else 0)\")\nprintf '{\"build.verdict\": \"rubric_met\", \"build.fix_rounds_used\": %s, \"build.rubric_result\": \".resolve/verify/rubric_result.json\"}' \"$count\"",
    parse_json="true"
  ];

  ExtractVerdictEscalated [
    shape=parallelogram, label="Extract Verdict (escalated)",
    tool_command="#!/bin/sh\nset -e\ncount=$(python3 -c \"import json,os;p='.resolve/fix_state.json';print(json.load(open(p))['count'] if os.path.exists(p) else 0)\")\nprintf '{\"build.verdict\": \"escalated\", \"build.fix_rounds_used\": %s, \"build.rubric_result\": \".resolve/verify/rubric_result.json\"}' \"$count\"",
    parse_json="true"
  ];

  Start          -> Implement;
  Implement      -> SelfEvaluate;
  SelfEvaluate   -> CheckRubric;
  CheckRubric    -> ExtractVerdictMet       [condition="context.tool.last_line=pass", weight="2", label="rubric met"];
  CheckRubric    -> CheckFixRounds          [condition="context.tool.last_line=fail", label="rubric unmet"];
  CheckFixRounds -> Fix                     [condition="context.tool.last_line=fix_ok",       label="fix round (backstop max $max_fix_rounds)"];
  CheckFixRounds -> ExtractVerdictEscalated [condition="context.tool.last_line=fix_exhausted", label="backstop tripped -- escalate"];
  Fix            -> SelfEvaluate            [loop_restart="true"];
  ExtractVerdictMet       -> Exit;
  ExtractVerdictEscalated -> Exit;
}
