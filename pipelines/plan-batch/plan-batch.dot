// plan-batch.dot
//
// A PLANNER attractor: read ONE GitHub issue and converge on a plan.json
// that the deterministic goal-plan compiler ACCEPTS -- or abort honestly
// with a residual note and no plan.json at all.
//
// Runs inside a GitHub Actions job via the microsoft/amplifier-app-actions
// action. See pipelines/plan-batch/plan-batch.md for the full contract and
// the consuming workflow (.github/workflows/plan-batch.yml).
//
// ---------------------------------------------------------------------------
// DESIGN ORDER (docs/primer.md sect.3 / docs/RUBRIC.md sect.0) -- sink, gate, loop,
// then work nodes:
//
//   1. SINK  -- a plan.json at the workspace root that
//               `python3 -m compiler plan.json -o /tmp/plan-check.dot`
//               exits 0 on. That command, run by a machine, is what proves
//               this pipeline is done. Nothing else counts.
//   2. GATE  -- CompilerGate: a deterministic shape=parallelogram tool node
//               that runs exactly that command and routes on its REAL exit
//               code plus the real existence of the artifacts it should have
//               produced. It never asks an LLM whether the plan is valid.
//   3. LOOP  -- rejection routes CompilerGate -> CheckAttempts -> RevisePlan
//               -> InstallPlan -> CompilerGate, carrying the compiler's own
//               named error as ONE curated line (not an append-only pile).
//               CheckAttempts is a real decision point with a cap; hitting
//               the cap routes to Abort (a residual note), never to a bare
//               fail and never to a shipped-anyway plan.
//   4. WORK  -- only then AuthorPlan / RevisePlan, the two LLM nodes.
//
// THREE-QUESTION TEST (docs/RUBRIC.md sect.1):
//   - Is there a cycle? Yes: InstallPlan -> CompilerGate -> CheckAttempts ->
//     RevisePlan -> InstallPlan, closed by loop_restart on RevisePlan's
//     forward edge.
//   - Is the exit gated on evidence? Yes: MarkAccepted is reachable only
//     through CompilerGate's `plan_ok` line, which requires compiler exit 0
//     AND a non-empty generated parent .dot AND a non-empty plan.json.
//   - Would it still land if an LLM node had a bad day? Yes. A malformed,
//     hallucinated, or entirely missing plan cannot reach MarkAccepted; it
//     loops with the compiler's named reason, and after the cap it aborts
//     with plan.json deliberately REMOVED so a bad plan cannot be shipped
//     downstream by a workflow step that only checks "did the job finish".
//
// ---------------------------------------------------------------------------
// RUNTIME CONTRACT (amplifier-app-actions -- verified, obey exactly)
//
//   INPUT: there is NO param channel. The only runtime-variable input that
//   reaches this graph is the built-in `$goal` substitution, which the action
//   sets to a formatted GitHub issue context block (event type, #number,
//   owner/repo, Title, Body, Labels, Author). Both LLM nodes consume `$goal`
//   directly; nothing else is parameterised. Where a knob would be useful
//   (the attempt cap) it is written as a shell default -- `${plan_max_attempts:-4}`
//   -- which resolves to 4 today and would pick up a real param for free if a
//   param channel ever appears. (Engine substitution leaves an unknown
//   `${key:-default}` token literal, so /bin/sh applies the default.)
//
//   CWD: the process cwd is $GITHUB_WORKSPACE (the checked-out repo).
//   Tool nodes (shape=parallelogram) resolve cwd via context.target_dir ->
//   graph.source_dir -> process cwd (docs/RUBRIC.md sect.3.8), which is NOT
//   guaranteed to be the workspace when this graph is fetched from a
//   git+https:// URL. Every tool node below therefore re-anchors explicitly
//   with `PB_WS=${GITHUB_WORKSPACE:-$PWD}` and uses "$PB_WS/plan.json"
//   instead of trusting an inherited cwd.
//
//   LLM FILE WRITES: agent (shape=box) nodes have an unreliable cwd, so
//   neither LLM node is ever asked to write a RELATIVE path. They write to
//   the fixed ABSOLUTE path /tmp/plan-batch/plan.json, which is
//   cwd-independent, and the engine's `must_write=` fail-closed artifact
//   contract asserts the write actually happened (existence + freshness +
//   non-trivial content) rather than trusting the node's own success line
//   (docs/RUBRIC.md sect.2). The workspace write itself -- the file the rest of the
//   workflow consumes -- is performed by the deterministic InstallPlan tool
//   node, never by an LLM.
//
//   ALL PIPELINE STATE lives under /tmp/plan-batch/ (absolute, cwd-independent,
//   and it keeps the checked-out repo clean for the workflow steps that commit
//   afterwards). The workspace receives exactly one file on success --
//   plan.json -- and exactly one file on abort -- plan-batch-residual.md.
//
// ---------------------------------------------------------------------------
// FOOT-GUNS RESPECTED (docs/primer.md sect.6 / docs/RUBRIC.md sect.3)
//
//   sect.3.1  No shape=diamond anywhere. Every gate is either a deterministic
//          shape=parallelogram routing on context.tool.last_line, or nothing.
//          There is no LLM judgment gate in this graph at all -- the compiler
//          is the judge and it is free, exhaustive and incorruptible.
//   sect.3.2  FAIL does not traverse plain edges. Every node that can FAIL has an
//          explicit `condition="outcome=fail"` edge: the two LLM nodes route
//          a hard failure (including a must_write= contract violation) into
//          the bounded loop at CheckAttempts, and the two deterministic gates
//          route a hard crash straight to Abort -- an attractor absorbs model
//          drift, not broken tools (docs/primer.md sect.4.7), so an infra crash
//          must not burn revision budget.
//   sect.3.4  Nothing in this graph reads $last_response. Every routing decision
//          reads either an exit code or a file. The 200-char truncation under
//          default_fidelity="summary:high" therefore cannot affect routing --
//          which is exactly why the LLM nodes are told to write a file and
//          print a short marker rather than emit multi-KB JSON as prose.
//   sect.3.5  All routing is on context.tool.last_line, never tool.output. Each
//          tool_command prints exactly one label to stdout and sends every
//          diagnostic to a file or to stderr.
//   sect.3.9  Checkpoints do not resume, so ResetPlanState is a real node: a
//          reused CI checkout carrying a stale plan.json or a stale attempt
//          counter would otherwise let a prior run's artifact sail through
//          the gate, or start this run's budget already spent (docs/RUBRIC.md sect.4,
//          idempotency -- the same bug fixed in idea_to_pr.dot's ResetFixState).
//
// TIER DISCIPLINE (docs/primer.md sect.4.1): only two nodes are LLM nodes, and both
// are there for judgment (how to cut an issue into independently verifiable
// lanes). Every other node is deterministic shell. There is deliberately no
// "Report" box node -- summarising a known outcome is typing, not judgment, so
// the terminals are parallelogram context stamps instead.
//
// ---------------------------------------------------------------------------
// Context inputs:
//   $goal - the GitHub issue context block, supplied by amplifier-app-actions.
//
// Context outputs:
//   plan.result  - "accepted" | "aborted"
//   plan.path    - "plan.json" (relative to $GITHUB_WORKSPACE) when accepted
//   plan.residual - "plan-batch-residual.md" when aborted
//
// Required env: ANTHROPIC_API_KEY (provider auth), GH_TOKEN (issue access by
// the surrounding workflow). GITHUB_WORKSPACE is provided by the runner.
//
// USAGE (remote source, no local checkout of this repo needed by the caller):
//   git+https://github.com/kenotron-ms/attractor-pipelines@main#subdirectory=pipelines/plan-batch/plan-batch.dot

digraph plan_batch {
  graph [
    label="Plan Batch -- GitHub issue to a compiler-accepted plan.json",
    goal="$goal",
    rankdir=LR,
    default_max_retry=2,
    default_fidelity="summary:high",
    // Unit-suffixed on purpose: a BARE integer here is MILLISECONDS
    // (docs/primer.md sect.6, EXTENSIONS sect.15), so "45m" is the safe spelling.
    max_pipeline_duration="45m",
    // The engine fails loud without an explicit model. Reasoning effort is
    // spent on the GENERATOR here rather than on a gate, because this
    // pipeline's gate is a deterministic compiler -- already perfect and
    // free -- so generator quality is what sets the iteration count.
    model_stylesheet="* { llm_model: claude-sonnet-4-6; llm_provider: anthropic; } #AuthorPlan { reasoning_effort: high; } #RevisePlan { reasoning_effort: high; }"
  ];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  // ---------------------------------------------------------------------
  // Idempotency guard. Checkpoints do not resume (docs/RUBRIC.md sect.3.9), and a
  // GitHub Actions checkout can be reused, so a fresh run must start from a
  // clean slate: no stale plan.json that the gate would happily accept
  // without this run's planner ever succeeding, no stale attempt counter
  // that would trip the abort cap prematurely, no stale error line that
  // RevisePlan would chase.
  // ---------------------------------------------------------------------
  ResetPlanState [
    shape=parallelogram, label="Reset Plan State",
    timeout="1m",
    tool_command="#!/bin/sh\nPB_WS=${GITHUB_WORKSPACE:-$PWD}\nrm -rf /tmp/plan-batch\nmkdir -p /tmp/plan-batch\nrm -f /tmp/plan-check.dot\nrm -f \"$PB_WS/plan.json\" \"$PB_WS/plan-batch-residual.md\"\nprintf '0' > /tmp/plan-batch/attempts.txt\n: > /tmp/plan-batch/history.log\nprintf 'no error recorded yet' > /tmp/plan-batch/last_error.txt\nprintf 'reset'\n"
  ];

  // ---------------------------------------------------------------------
  // WORK NODE 1 -- the planner. Judgment: how to cut this issue into lanes
  // that can actually be verified by a machine. Writes ONLY to the absolute
  // path /tmp/plan-batch/plan.json; must_write= makes the engine fail the
  // node closed if that artifact is absent, stale, or whitespace-only, so a
  // node that "says" it wrote the plan but did not cannot pass this point.
  // ---------------------------------------------------------------------
  AuthorPlan [
    shape=box, fidelity="summary:high",
    label="Author plan.json from the issue",
    timeout="12m",
    must_write="/tmp/plan-batch/plan.json",
    prompt="You are the PLANNER node of a compiler-gated attractor pipeline. Turn ONE GitHub issue into a goal-batch decomposition and write it as strict JSON to the ABSOLUTE path /tmp/plan-batch/plan.json.\n\nTHE ISSUE (supplied by the GitHub Actions runner as this pipeline's goal -- it carries the event type, the issue #number, owner/repo, Title, Body, Labels and Author):\n$goal\n\nGROUND RULES\n- Write to /tmp/plan-batch/plan.json EXACTLY (run `mkdir -p /tmp/plan-batch` first). Agent nodes in this engine do not have a dependable working directory, so an absolute path is the only safe target. A deterministic downstream node copies it into the workspace.\n- Do NOT run the compiler yourself and do NOT declare the plan valid. A deterministic gate runs `python3 -m compiler plan.json -o /tmp/plan-check.dot` immediately after you and its exit code -- not your opinion -- decides what happens next. If it rejects your plan you will be handed its exact named error and asked to fix that one thing.\n- Output strict JSON only: no comments, no trailing commas, no markdown fence around the file contents.\n\nSTEP 1 -- READ THE AUTHORITATIVE SCHEMA.\nThe checked-out repository (the GITHUB_WORKSPACE env var) contains compiler/README.md, which is the integration contract for this plan.json. Read it with bash before writing anything:\n  cat \"${GITHUB_WORKSPACE:-.}/compiler/README.md\"\nIt is the source of truth for every field, every charset restriction and every cross-field rule. The reminder in STEP 3 is a floor, not a replacement -- when the two disagree, compiler/README.md wins.\n\nSTEP 2 -- DECOMPOSE THE ISSUE (goalify discipline).\nA lane is ONE independently completable unit of work, sized so a single agent can finish it in one sitting. For every lane you must be able to name a command that would FAIL if that lane's work were reverted. That command is the lane's `verifier_argv`.\n- verifier_argv is the load-bearing field. It must be a real, machine-checkable command -- a test invocation, a build, a linter, a grep for a concrete artifact -- that exits 0 ONLY when the lane's work is genuinely done. An agent's self-report is not a verifier. If you cannot name such a command for a lane, the lane is not well formed: re-cut it until you can.\n- Lanes that can proceed at the same time share a `wave`. A lane that needs another lane's output belongs to a LATER wave and must name that lane in `depends_on`.\n- Every entry in `depends_on` must name a real lane that is in an earlier-or-equal wave AND appears earlier in `integration_order`. The compiler enforces this; a dependency it cannot structurally satisfy is rejected.\n- `integration_order` is a permutation of ALL lane ids, non-decreasing by wave (every earlier-wave lane precedes every later-wave lane).\n- Aim for 2-6 lanes. One lane means this issue did not need a batch -- say so in `description` and still emit the single lane. More than 8 lanes means the issue is too big to plan as one batch: cut the smallest coherent slice that stands on its own, plan that, and state plainly in `description` what you deferred and why.\n- `marker_file` / `marker_content` are the lane's completion marker; pick a path under artifacts/ named after the lane and content of the form <lane_id>:ok.\n\nSTEP 3 -- REQUIRED SHAPE (floor; compiler/README.md is authoritative).\nTop level: `plan_id`, `lanes`, `waves`, `integration_order`, `terminals`.\n- `plan_id`: derive from the issue number in $goal as issue_<n> (e.g. issue_412). If the goal carries no issue number, derive it from the title. It MUST match ^[A-Za-z_][A-Za-z0-9_]*$ -- letters, digits and underscores only, NO hyphens, and it must not start with a digit. Sanitize accordingly.\n- `lanes`: an object mapping lane_id -> { \"wave\": <int >= 1>, \"depends_on\": [<lane ids>], \"verifier_argv\": [<argv strings>, non-empty], \"marker_file\": <path>, \"marker_content\": <string> }. Lane ids must match ^[A-Za-z][A-Za-z0-9_-]{0,63}$.\n- `waves`: [{\"wave\": 1}, {\"wave\": 2}, ...] -- strictly increasing, unique, and EVERY declared wave must have at least one lane assigned to it. Optional per-wave \"concurrency\": <int >= 1>.\n- `integration_order`: [<every lane id exactly once>], non-decreasing by wave.\n- `terminals`: [\"COMPLETE\", \"RESIDUALS_READY\", \"INFRA_FAILURE\", \"ABORTED\"].\nAlso set a human-readable `description` explaining the decomposition, and `budgets` with realistic values for real implementation work (the smoke-fixture defaults are far too small): { \"max_adaptive_attempts_per_lane\": 3, \"lane_wall_timeout_seconds\": 3600, \"verifier_timeout_seconds\": 300 }.\n\nSTEP 4 -- WRITE AND STOP.\nWrite the JSON to /tmp/plan-batch/plan.json. Verify with `cat /tmp/plan-batch/plan.json` that the file on disk is the complete document you intended. Do not narrate the plan back at length -- the file is the deliverable. Print the single line: plan_authored"
  ];

  // ---------------------------------------------------------------------
  // The workspace write. Deterministic on purpose: this is the file the rest
  // of the workflow consumes, so no LLM is allowed to place it. Also
  // pre-checks JSON parseability, because `python3 -m compiler` on
  // unparseable JSON raises a raw JSONDecodeError traceback (exit 1) instead
  // of the clean `error: invalid plan spec: ...` line the loop feeds on --
  // catching it here keeps the feedback channel curated and named.
  // ---------------------------------------------------------------------
  InstallPlan [
    shape=parallelogram, label="Install plan.json into the workspace",
    timeout="2m",
    tool_command="#!/bin/sh\nPB_WS=${GITHUB_WORKSPACE:-$PWD}\nSRC=/tmp/plan-batch/plan.json\nmkdir -p /tmp/plan-batch\nATT=$(cat /tmp/plan-batch/attempts.txt 2>/dev/null || printf '0')\ncase \"$ATT\" in ''|*[!0-9]*) ATT=0 ;; esac\nATT=$((ATT + 1))\nfail() {\n  printf '%s\\n' \"$1\" > /tmp/plan-batch/last_error.txt\n  printf 'attempt %s: %s\\n' \"$ATT\" \"$1\" >> /tmp/plan-batch/history.log\n  printf 'install_failed'\n  exit 0\n}\nif [ ! -s \"$SRC\" ]; then\n  fail 'The previous attempt produced no artifact: /tmp/plan-batch/plan.json is missing or empty. Author the plan from scratch and write it to that exact absolute path.'\nfi\nif ! python3 -c \"import json,sys; json.load(open(sys.argv[1]))\" \"$SRC\" 2> /tmp/plan-batch/json_error.txt; then\n  fail \"The plan is not valid JSON. The Python parser said: $(tail -1 /tmp/plan-batch/json_error.txt)\"\nfi\nif ! cp \"$SRC\" \"$PB_WS/plan.json\"; then\n  fail \"Could not copy $SRC to $PB_WS/plan.json.\"\nfi\nprintf 'installed'\n"
  ];

  // ---------------------------------------------------------------------
  // THE GATE. The whole pipeline exists to make this node print plan_ok.
  //
  // It is deliberately stricter than "exit 0": the compiler writes nothing on
  // rejection, so a stale /tmp/plan-check.dot from a previous attempt could
  // otherwise look like fresh evidence -- it is removed first, then required
  // to exist non-empty alongside plan.json before plan_ok is printed. This is
  // the independent verification docs/RUBRIC.md sect.2 demands, applied to the one
  // claim that matters here.
  //
  // On rejection it records ONE curated line (the compiler's own named
  // reason) for RevisePlan to act on, plus an append-only history.log that
  // exists solely so RevisePlan can tell whether the loop is contracting or
  // oscillating (docs/primer.md sect.4.9). The curated single line -- not the log --
  // is what drives the next attempt, so the feedback channel cannot silt up.
  // ---------------------------------------------------------------------
  CompilerGate [
    shape=parallelogram, label="Compiler Gate (python3 -m compiler)",
    timeout="5m",
    tool_command="#!/bin/sh\nPB_WS=${GITHUB_WORKSPACE:-$PWD}\nmkdir -p /tmp/plan-batch\nATT=$(cat /tmp/plan-batch/attempts.txt 2>/dev/null || printf '0')\ncase \"$ATT\" in ''|*[!0-9]*) ATT=0 ;; esac\nATT=$((ATT + 1))\nrm -f /tmp/plan-check.dot\nif ! cd \"$PB_WS\"; then\n  printf 'Could not enter the workspace directory %s.\\n' \"$PB_WS\" > /tmp/plan-batch/last_error.txt\n  printf 'plan_rejected'\n  exit 0\nfi\nreason=''\nif python3 -m compiler plan.json -o /tmp/plan-check.dot > /tmp/plan-batch/compiler_stdout.txt 2> /tmp/plan-batch/compiler_stderr.txt; then\n  if [ -s /tmp/plan-check.dot ] && [ -s plan.json ]; then\n    printf 'plan_ok'\n    exit 0\n  fi\n  reason='The compiler exited 0 but produced no non-empty parent .dot (or plan.json vanished) -- treat the plan as rejected.'\nfi\nif [ -z \"$reason\" ]; then\n  reason=$(grep -m1 '^error: invalid plan spec:' /tmp/plan-batch/compiler_stderr.txt 2>/dev/null)\nfi\nif [ -z \"$reason\" ]; then\n  reason=\"The compiler failed without emitting a named plan-spec error. Last stderr: $(tail -3 /tmp/plan-batch/compiler_stderr.txt 2>/dev/null | tr '\\n' ' ')\"\nfi\nprintf '%s\\n' \"$reason\" > /tmp/plan-batch/last_error.txt\nprintf 'attempt %s: %s\\n' \"$ATT\" \"$reason\" >> /tmp/plan-batch/history.log\nprintf 'plan_rejected'\n"
  ];

  // ---------------------------------------------------------------------
  // The bound, and it is a DECISION POINT, not a fuse (docs/primer.md sect.4.5).
  // Counts authoring attempts, not engine retries: default_max_retry only
  // bounds a single node's own execution attempts, it does not limit how
  // many times the graph traverses a back-edge. Reaching the cap routes to
  // Abort, which produces a readable residual note -- not a silent exit and
  // not a bare FAIL.
  //
  // Budget: attempts.txt starts at 0, so 1 initial authoring pass plus 3
  // revisions = 4 authoring attempts before the cap trips.
  // ---------------------------------------------------------------------
  CheckAttempts [
    shape=parallelogram, label="Check Attempts (bounded decision)",
    timeout="1m",
    tool_command="#!/bin/sh\nmkdir -p /tmp/plan-batch\ncount=$(cat /tmp/plan-batch/attempts.txt 2>/dev/null || printf '0')\ncase \"$count\" in ''|*[!0-9]*) count=0 ;; esac\ncount=$((count + 1))\nprintf '%s' \"$count\" > /tmp/plan-batch/attempts.txt\nmax=${plan_max_attempts:-4}\nif [ \"$count\" -lt \"$max\" ]; then\n  printf 'revise_ok'\nelse\n  printf 'attempts_exhausted'\nfi\n"
  ];

  // ---------------------------------------------------------------------
  // WORK NODE 2 -- the repair pass. Separate from AuthorPlan on purpose: a
  // retry that re-runs the original prompt is a coin re-flip, same
  // distribution, new sample (docs/primer.md sect.4.4). This node is prompted
  // against the compiler's own named error and is told to change ONLY what
  // that error requires -- and, if the history shows the same rejection
  // twice, to stop patching the symptom and re-cut the decomposition
  // (docs/primer.md sect.4.7: an attractor absorbs model drift, not a wrong plan
  // shape).
  //
  // Same must_write= contract as AuthorPlan: a repair pass that does not
  // actually rewrite the artifact fails closed instead of silently
  // re-submitting the previous attempt to the gate.
  // ---------------------------------------------------------------------
  RevisePlan [
    shape=box, fidelity="summary:high",
    label="Revise plan.json (compiler-named error)",
    timeout="10m",
    must_write="/tmp/plan-batch/plan.json",
    prompt="You are the REPAIR node of a compiler-gated attractor pipeline. The previous plan.json did not survive the deterministic gate. Fix exactly what was named -- nothing else.\n\nTHE ISSUE (unchanged; still the thing being planned):\n$goal\n\nSTEP 1 -- READ THE RECORDED REJECTION.\n  cat /tmp/plan-batch/last_error.txt\nThat file holds ONE curated line describing why the last attempt did not pass. Then read the attempt history:\n  cat /tmp/plan-batch/history.log\n\nSTEP 2 -- READ THE CURRENT ATTEMPT (it may not exist):\n  cat /tmp/plan-batch/plan.json\n\nSTEP 3 -- HANDLE WHICHEVER CASE APPLIES.\n(a) The error says no artifact was produced, or /tmp/plan-batch/plan.json is missing/empty -> the previous attempt never wrote a file. Author the plan from scratch against `cat \"${GITHUB_WORKSPACE:-.}/compiler/README.md\"` and write it to /tmp/plan-batch/plan.json.\n(b) The error says the plan is not valid JSON -> the content is malformed, not the design. Re-emit the same decomposition as strict JSON: no comments, no trailing commas, no markdown fence, no truncation.\n(c) The error begins `error: invalid plan spec:` -> the compiler named a specific field, lane or cross-field rule. Read that exact rule in `cat \"${GITHUB_WORKSPACE:-.}/compiler/README.md\"` and change ONLY what the rule requires. Do not redesign lanes that were not implicated.\n\nSTEP 4 -- WATCH THE REGIME.\nIf history.log shows you already attempted this same repair and it was rejected again, stop patching the symptom: the DECOMPOSITION is wrong, not the syntax. Re-cut the lanes, waves, depends_on and integration_order so the violated constraint is satisfied by construction -- most commonly by moving a lane to a later wave, or by reordering integration_order so every dependency precedes its dependent.\n\nCONSTRAINTS THAT ARE MOST OFTEN THE CULPRIT:\n- plan_id must match ^[A-Za-z_][A-Za-z0-9_]*$ (no hyphens, no leading digit).\n- Every declared wave must have at least one lane; an empty wave is rejected.\n- integration_order must be a permutation of ALL lane ids and non-decreasing by wave.\n- Every depends_on entry must name a real lane in an earlier-or-equal wave that also precedes this lane in integration_order.\n- verifier_argv must be present and non-empty for every lane.\n- terminals must be present and non-empty.\n\nSTEP 5 -- WRITE AND STOP.\nWrite the corrected plan to the ABSOLUTE path /tmp/plan-batch/plan.json (overwrite it). Confirm with `cat /tmp/plan-batch/plan.json` that the file on disk is the complete corrected document. Do not run the compiler yourself and do not claim the plan is now valid -- the gate decides. Print the single line: plan_revised"
  ];

  // ---------------------------------------------------------------------
  // TERMINAL: converged. Reachable only through CompilerGate's plan_ok line,
  // which already required compiler exit 0 plus real artifacts on disk. This
  // node does no verification of its own -- it is a deterministic context
  // stamp, which is why it is a parallelogram and not a box (an LLM here
  // would be typing, not judging).
  // ---------------------------------------------------------------------
  MarkAccepted [
    shape=parallelogram, label="Mark Accepted (compiler-verified)",
    timeout="1m",
    tool_command="printf '{\"plan.result\": \"accepted\", \"plan.path\": \"plan.json\"}'",
    parse_json="true"
  ];

  // ---------------------------------------------------------------------
  // TERMINAL: budget exhausted, or a deterministic gate crashed outright.
  //
  // Removing plan.json is the point of this node. A rejected plan left in the
  // workspace is worse than no plan: the consuming workflow relocates and
  // publishes whatever plan.json it finds, so a malformed one would be
  // shipped by a job that "completed". Deleting it makes the absence of
  // plan.json the workflow's own evidence-based gate, and the residual note
  // explains -- with the compiler's real words and the full attempt history
  // -- what went wrong, so a human gets a diagnosis rather than a shrug.
  // ---------------------------------------------------------------------
  Abort [
    shape=parallelogram, label="Abort (residual note, no plan.json)",
    timeout="2m",
    tool_command="#!/bin/sh\nPB_WS=${GITHUB_WORKSPACE:-$PWD}\nattempts=$(cat /tmp/plan-batch/attempts.txt 2>/dev/null || printf '?')\nreason=$(cat /tmp/plan-batch/last_error.txt 2>/dev/null || printf 'no compiler error was recorded')\nrm -f \"$PB_WS/plan.json\"\n{\n  printf '# plan-batch: no compiler-valid plan.json was produced\\n\\n'\n  printf 'The planner made %s authoring attempt(s). The deterministic gate\\n' \"$attempts\"\n  printf '(python3 -m compiler plan.json -o /tmp/plan-check.dot) rejected every one,\\n'\n  printf 'or failed outright, so this run produced NO plan.json. That absence is\\n'\n  printf 'intentional: a plan the compiler rejects must not be shipped downstream.\\n\\n'\n  printf 'Last recorded reason:\\n\\n    %s\\n\\n' \"$reason\"\n  printf 'Attempt history:\\n\\n'\n  sed 's/^/    /' /tmp/plan-batch/history.log 2>/dev/null\n  printf '\\nNext steps: clarify the issue so the lanes can be cut with real\\n'\n  printf 'machine-checkable verifiers, or hand-author a plan.json against\\n'\n  printf 'compiler/README.md and re-run.\\n'\n} > \"$PB_WS/plan-batch-residual.md\" 2>/dev/null || true\nprintf 'aborted'\nexit 0\n"
  ];

  MarkAborted [
    shape=parallelogram, label="Mark Aborted",
    timeout="1m",
    tool_command="printf '{\"plan.result\": \"aborted\", \"plan.residual\": \"plan-batch-residual.md\"}'",
    parse_json="true"
  ];

  // ═══════════════════════════════════════ EDGES ═══════════════════════════

  Start          -> ResetPlanState;
  ResetPlanState -> AuthorPlan;

  AuthorPlan     -> InstallPlan;
  // FAIL does not traverse the plain edge above (docs/RUBRIC.md sect.3.2). A hard
  // failure here -- including a must_write= contract violation after retries
  // -- is model failure, so it enters the bounded loop rather than dead-ending.
  AuthorPlan     -> CheckAttempts [condition="outcome=fail", label="no artifact / node failed"];

  InstallPlan    -> CompilerGate  [condition="context.tool.last_line=installed", weight="2", label="installed"];
  InstallPlan    -> CheckAttempts [condition="context.tool.last_line=install_failed", label="unusable artifact"];
  // The tool itself crashed (no python3, unwritable workspace): infrastructure,
  // not model drift -- do not spend revision budget on it (docs/primer.md sect.4.7).
  InstallPlan    -> Abort         [condition="outcome=fail", label="infra failure"];

  // ── THE GATE ─────────────────────────────────────────────────────────────
  CompilerGate   -> MarkAccepted  [condition="context.tool.last_line=plan_ok", weight="2", label="compiler accepted"];
  CompilerGate   -> CheckAttempts [condition="context.tool.last_line=plan_rejected", label="compiler rejected"];
  CompilerGate   -> Abort         [condition="outcome=fail", label="infra failure"];

  // ── THE BOUND ────────────────────────────────────────────────────────────
  CheckAttempts  -> RevisePlan    [condition="context.tool.last_line=revise_ok", label="revise (max $plan_max_attempts, default 4)"];
  CheckAttempts  -> Abort         [condition="context.tool.last_line=attempts_exhausted", label="budget spent -- escalate"];
  CheckAttempts  -> Abort         [condition="outcome=fail", label="infra failure"];

  // ── THE LOOP ─────────────────────────────────────────────────────────────
  RevisePlan     -> InstallPlan   [loop_restart="true", label="re-submit to the gate"];
  RevisePlan     -> CheckAttempts [condition="outcome=fail", label="no artifact / node failed"];

  MarkAccepted   -> Exit;
  Abort          -> MarkAborted;
  MarkAborted    -> Exit;
}
