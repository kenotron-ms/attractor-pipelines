// idea_to_shipped.dot
//
// Sample pipeline: full "idea to shipped" SDLC arc, mined from real
// successful Amplifier Resolve session histories (think -> plan -> build ->
// fix loop -> PR -> merge gate -> deploy gate).
//
// Flow:
//   Start -> Brainstorm -> Plan -> PlanConfidenceCheck -> (confident: skip
//   straight to Implement) | (needs_review: PlanApproval human gate -> revise
//   or proceed) -> Implement(subgraph: build_loop.dot, loops internally on
//   verdict fail) -> DeliverPR(subgraph) -> MergeGate(subgraph, human
//   hexagon) -> DeployGate(subgraph, human hexagon) -> Report -> Exit
//
// Context inputs:
//   $task              - the idea/problem statement kicking off the run
//   $repo              - target repo slug (owner/name) for PR/merge/deploy
//   $max_fix_rounds    - cap on build_loop fix iterations (default 3)
//
// Context outputs:
//   brainstorm.design_doc   - path to the validated design written by Brainstorm
//   plan.todo_path          - path to TODO.md written by Plan
//   delivery.pr_url         - PR URL, set by DeliverPR subgraph
//   delivery.merge_sha      - merge commit sha, set by MergeGate subgraph
//   deploy.result           - deploy outcome, set by DeployGate subgraph

digraph idea_to_shipped {
  graph [
    label="Idea to Shipped -- Full SDLC Pipeline",
    goal="$task",
    rankdir=LR,
    default_max_retry=2,
    default_fidelity="summary:high",
    model_stylesheet="* { llm_model: claude-sonnet-4-6; llm_provider: anthropic; }"
  ];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  // --- Phase 1: Idea -> validated design (mirrors /think-like-ken) ---
  Brainstorm [
    shape=box, goal_gate=true, fidelity="full",
    label="Brainstorm / Think-like-ken",
    prompt="Given the idea/problem statement in $task, explore intent, requirements, and design options as a design partner would (not a solution reviewer). Ask no questions back -- resolve ambiguity yourself using best judgment and note assumptions. Write the validated design to .resolve/design/design.md. Print the single line: brainstorm_done"
  ];

  // --- Phase 2: Design -> bite-sized task plan (mirrors /plan-like-ken) ---
  // NOT TDD. This is Verification Driven Development: pick the CHEAPEST
  // verification that actually proves a task works (static analysis -> run
  // it directly -> curl/HTTP -> browser -> DTU/reality-check), per the VDD
  // hierarchy. A unit test that mocks everything proves the mock works, not
  // the product.
  Plan [
    shape=box, goal_gate=true, fidelity="full",
    label="Plan / Plan-like-ken (VDD)",
    prompt="Read .resolve/design/design.md. Break it into a bite-sized (2-5 min each) task list. This is Verification Driven Development, NOT TDD -- do not default every task to 'write a unit test'. For EACH task, pick the cheapest verification level that actually proves it works: (1) native static analysis (ruff/ty/tsc) -- always, zero cost; (2) run the code directly; (3) curl/HTTP against a running server for endpoints; (4) browser via playwright-cli for UI changes; (5) DTU/reality-check only when true isolation is needed. Unit tests are right for library code, not a universal default. Also self-assess your CONFIDENCE per task: mark needs_review=true only if the design leaves real ambiguity (an unresolved ordering/scope/interface decision) -- most well-specified designs should NOT need review. Write .ai/plan.md (task list, each task with its exact verification command and expected output) and .ai/acceptance_criteria.md (measurable success criteria per task). Write .resolve/plan/confidence.json with {\"needs_review\": true|false, \"reasons\": [...]}. Print the single line: plan_done"
  ];

  // --- Phase 2.5: Judgment gate. This is NOT a rubber-stamp on every run --
  // most runs are confident and skip straight to Implement. Only pipe in a
  // human when the plan itself flags real ambiguity.
  PlanConfidenceCheck [
    shape=parallelogram, label="Plan Confidence Check",
    tool_command="#!/bin/sh\nset -e\nneeds=$(python3 -c \"import json;print(json.load(open('.resolve/plan/confidence.json'))['needs_review'])\" 2>/dev/null || echo True)\nif [ \"$needs\" = \"True\" ]; then printf 'needs_review'; else printf 'confident'; fi"
  ];

  PlanApproval [
    shape=hexagon, mode="freeform",
    label="Plan Approval (only when unsure)",
    prompt="The plan flagged real ambiguity before implementation begins -- see .resolve/plan/confidence.json for reasons. Review .ai/plan.md. Type 'approve'/'yes'/'ok' to proceed as planned, or reply with corrections to send back for revision."
  ];

  CheckPlanApproval [
    shape=parallelogram, label="Check Plan Approval",
    tool_command="bash -c 'if echo \"$last_response\" | grep -iEq \"approve|\\byes\\b|\\bok\\b\"; then echo approved; else echo revise; fi'"
  ];

  RevisePlan [
    shape=box, goal_gate=true, fidelity="full",
    label="Revise Plan",
    prompt="Incorporate the human's corrections (${last_response}) into .ai/plan.md and .resolve/plan/confidence.json. Print the single line: plan_revised"
  ];

  // --- Phase 3: Build with verdict-gated fix loop (see subgraphs/build_loop.dot) ---
  Implement [
    shape=folder, label="Implement (build + verify + fix loop)",
    dot_file="subgraphs/build_loop.dot",
    outputs="build.verdict,build.fix_rounds_used"
  ];

  // --- Phase 4: Open PR (see subgraphs/deliver_pr.dot) ---
  DeliverPR [
    shape=folder, label="Deliver PR",
    dot_file="subgraphs/deliver_pr.dot",
    outputs="delivery.pr_url,delivery.result"
  ];

  // --- Phase 5: Human merge gate + merge (see subgraphs/merge_gate.dot) ---
  MergeGate [
    shape=folder, label="Merge Gate",
    dot_file="subgraphs/merge_gate.dot",
    outputs="delivery.merge_sha,delivery.merge_result"
  ];

  // --- Phase 6: Human deploy gate + deploy (see subgraphs/deploy_gate.dot) ---
  DeployGate [
    shape=folder, label="Deploy Gate",
    dot_file="subgraphs/deploy_gate.dot",
    outputs="deploy.result"
  ];

  Report [
    shape=box, goal_gate=true, fidelity="summary:high",
    label="Report",
    prompt="Summarize the full run: design decisions (.resolve/design/design.md), fix rounds used (${build.fix_rounds_used}), PR (${delivery.pr_url}), merge (${delivery.merge_sha}), and deploy result (${deploy.result}). Print the single line: reported"
  ];

  Start                -> Brainstorm;
  Brainstorm           -> Plan;
  Plan                 -> PlanConfidenceCheck;
  PlanConfidenceCheck  -> Implement     [condition="context.tool.last_line=confident", weight="2"];
  PlanConfidenceCheck  -> PlanApproval  [condition="context.tool.last_line=needs_review"];
  PlanApproval         -> CheckPlanApproval;
  CheckPlanApproval    -> Implement     [condition="context.tool.last_line=approved", weight="2"];
  CheckPlanApproval    -> RevisePlan    [condition="context.tool.last_line=revise"];
  RevisePlan           -> PlanConfidenceCheck [loop_restart="true"];
  Implement            -> DeliverPR;
  DeliverPR            -> MergeGate  [condition="context.delivery.result=opened", weight="2"];
  DeliverPR            -> Report     [condition="outcome=fail"];
  MergeGate            -> DeployGate [condition="context.delivery.merge_result=merged", weight="2"];
  MergeGate            -> Report     [condition="context.delivery.merge_result=rejected"];
  DeployGate           -> Report;
  Report               -> Exit;
}
