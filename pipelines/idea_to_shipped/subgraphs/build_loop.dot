// build_loop.dot
//
// Verdict-gated build loop: Implement -> VerifySpec -> QualityReview ->
// VerdictGate -> (pass: exit) | (fail: CheckFixRounds -> BuildFixTasks ->
// loop back to Implement). Modeled on amplifier-resolver-dot-graph's
// develop.dot Ralph-loop pattern, mined from real fix-loop session arcs.
//
// NOT TDD. This is Verification Driven Development (VDD): human attention
// is sacred, so every task proves itself with the CHEAPEST verification
// that actually shows it works (static analysis, run it directly, curl,
// browser, DTU/reality-check) -- not a reflexive "write a unit test."
// VerifySpec applies the restless-old-brian lens: is it REAL, proven
// end-to-end as a user would experience it -- proof over claims, plumbing
// before polish, fail loud over silent fallbacks.
//
// Required context variables (injected by parent via graph attrs / $vars):
//   $max_fix_rounds  - cap on fix iterations (default 3)
//
// Context outputs (declared via `outputs=` on the folder node in the parent):
//   build.verdict          - final "pass" | "exhausted"
//   build.fix_rounds_used  - integer count of fix rounds consumed

digraph build_loop {
  graph [rankdir=LR, default_max_retry=2, default_fidelity="summary:high"];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  Implement [
    shape=box, goal_gate=true, fidelity="full",
    label="Implement Next Task (VDD)",
    prompt="Read .ai/plan.md. Implement the next unchecked [ ] task. This is Verification Driven Development, NOT TDD -- do not default to writing a unit test first. Use the verification method specified for this task in the plan (static analysis, direct execution, curl/HTTP, browser, or DTU) and run it for real: if you didn't run it, you haven't verified it. Check the task off only once its actual verification command has been run and passes. Print the single line: implement_done"
  ];

  VerifySpec [
    shape=box, goal_gate=true, fidelity="full",
    label="Spec/Verify Review (restless-old-brian lens)",
    prompt="Review the implementation against .ai/plan.md and .ai/acceptance_criteria.md using the restless-old-brian lens: is this REAL and proven end-to-end, the way a user would actually experience it -- not just 'the code exists' or 'a mock passed'? Demand proof over claims. Re-run each task's stated verification command yourself and confirm the actual output, don't trust a prior claim of success. Flag any silent fallback or swallowed error as a fail -- fail loud, don't hide problems. Write .resolve/verify/verdict.json with {\"verdict\": \"pass\"|\"fail\", \"findings\": [...]}. Print the single line: verify_done"
  ];

  QualityReview [
    shape=box, goal_gate=true, fidelity="full",
    label="Quality Review",
    prompt="Review code quality: readability, error handling, test coverage where tests are the right verification (library code), no dead code. Write .resolve/quality/verdict.json with {\"verdict\": \"pass\"|\"fail\", \"findings\": [...]}. Print the single line: quality_done"
  ];

  VerdictGate [
    shape=parallelogram, label="Verdict Gate",
    tool_command="#!/bin/sh\nset -e\nv1=$(python3 -c \"import json;print(json.load(open('.resolve/verify/verdict.json'))['verdict'])\" 2>/dev/null || echo fail)\nv2=$(python3 -c \"import json;print(json.load(open('.resolve/quality/verdict.json'))['verdict'])\" 2>/dev/null || echo fail)\nif [ \"$v1\" = \"pass\" ] && [ \"$v2\" = \"pass\" ]; then printf 'pass'; else printf 'fail'; fi"
  ];

  CheckFixRounds [
    shape=parallelogram, label="Check Fix Rounds",
    tool_command="#!/bin/sh\nset -e\nmkdir -p .ai\ncount=$(python3 -c \"import json,os;p='.ai/fix_state.json';d=json.load(open(p)) if os.path.exists(p) else {'count':0};d['count']+=1;json.dump(d,open(p,'w'));print(d['count'])\")\nmax=${max_fix_rounds:-3}\nif [ \"$count\" -le \"$max\" ]; then printf 'fix_ok'; else printf 'fix_exhausted'; fi"
  ];

  BuildFixTasks [
    shape=box, goal_gate=true, fidelity="full",
    label="Build Fix Tasks",
    prompt="Read the verdict findings in .resolve/verify/verdict.json and .resolve/quality/verdict.json. Append new [ ] tasks to .ai/plan.md addressing each failure, most specific/actionable first, each with its own exact verification command. Print the single line: fix_tasks_built"
  ];

  MoreTasks [
    shape=parallelogram, label="More Tasks Pending?",
    tool_command="#!/bin/sh\nset -e\nif grep -q '\\[ \\]' .ai/plan.md 2>/dev/null; then printf 'has_tasks'; else printf 'no_tasks'; fi"
  ];

  Start          -> Implement;
  Implement      -> VerifySpec;
  VerifySpec     -> QualityReview;
  QualityReview  -> VerdictGate;
  VerdictGate    -> MoreTasks       [condition="context.tool.last_line=pass", label="pass", weight="2"];
  VerdictGate    -> CheckFixRounds  [condition="context.tool.last_line=fail", label="fail"];
  CheckFixRounds -> BuildFixTasks   [condition="context.tool.last_line=fix_ok",       label="fix round"];
  CheckFixRounds -> Exit            [condition="context.tool.last_line=fix_exhausted", label="exhausted"];
  BuildFixTasks  -> Implement       [loop_restart="true", label="fix loop"];
  MoreTasks      -> Implement       [condition="context.tool.last_line=has_tasks", loop_restart="true", label="next task"];
  MoreTasks      -> Exit            [condition="context.tool.last_line=no_tasks"];
}
