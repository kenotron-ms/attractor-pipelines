// reality_check_smoke.dot
//
// The simplest possible pipeline in this repo that exercises the Amplifier
// Resolve platform's REAL reality-check broker API end to end: broker
// admission, Incus runner spin-up, DTU provisioning, deployment/clone,
// validation, and verdict callback -- all without writing, committing, or
// pushing anything to the target repo first. No planning, no rubric, no fix
// loop. The reality-check verdict IS the pipeline's terminal evidence; there
// is no redundant separate check.
//
// Pipeline shape:
//   Start -> PrepareRealityCheckInputs -> RealityCheck -> RenderVerdict -> Report -> Exit
//
// This pipeline is READ-ONLY against the target repo: it never writes,
// commits, or pushes anything, anywhere. Safe to run against ANY repo you can
// read (public, or private with a GH_TOKEN that has read access) -- no
// branch-protection interaction, no scratch-repo requirement, no risk of a
// direct unreviewed push to the target repo's default branch.
//
// Why a claim-free design is viable (confirmed by reading source, NOT
// assumed -- see reality_check_smoke.md for the full evidence trail with
// file:line references):
//
//   1. The reality-check runner resolves `software_path` via
//      `amplifier_reality_check_runner.inputs.resolve_software_path()`,
//      which does a plain `git clone --depth 1 <url> <target_dir>`
//      (optionally `--branch <ref>` for a resolver-encoded
//      `git+<url>@<ref>` form). This is a READ-ONLY clone. The only
//      credential involved is GH_TOKEN injected into the clone URL as
//      `https://x-access-token:<GH_TOKEN>@github.com/...` -- used purely for
//      read auth on private repos. Nothing in that function, or anywhere
//      else in the runner, ever pushes, commits, or writes back to the
//      source repo. WRITE/push access to the target repo is never required.
//
//   2. Nothing in the broker route (amplifier-resolve's
//      routes/reality_checks.py) or the SDK (amplifier_resolver_sdk's
//      _reality_check.py / reality_check_invoke.py) requires a fresh commit
//      to exist before a reality-check can run. `software_path` is carried
//      as an opaque string end to end; the broker never inspects or diffs
//      repo history. Any acceptance criteria that are true of the
//      *current* default-branch state validate exactly as well as
//      criteria written against a claim a pipeline just pushed itself.
//
// Given (1) and (2), this pipeline goes straight to preparing reality-check's
// inputs against whatever is ALREADY on the target repo's default branch --
// there is no local write/push step, and therefore nothing to route around
// before the broker call.
//
// Context inputs:
//   $repo  - target repo slug (owner/name) or full https URL. READ-ONLY --
//            no push rights required, no branch-protection interaction.
//   $spec  - optional. If set, overrides the default acceptance criteria
//            (see PrepareRealityCheckInputs) with your own already-true
//            claim about the target repo.
//
// Context outputs:
//   smoke.result       - "passed" | "failed"
//   rc.verdict         - "pass" | "partial" | "fail" | "None"
//   rc.status          - broker session terminal status
//   rc.failure_mode    - broker failure_mode, or "None"
//   rc.session_id      - broker session id (n/a if never started)
//
// Default acceptance criteria (generic, and independently verified true
// right now for kenotron-ms/test-resolve-repo by directly cloning it and
// inspecting its content -- see reality_check_smoke.md for the exact
// command output used as evidence): the cloned repository must be a
// valid, non-empty git working tree that contains a non-empty README.md at
// its root. This holds for essentially any real GitHub repo, not just the
// one it was verified against.

digraph reality_check_smoke_readonly {
  graph [
    label="Reality Check Smoke (read-only) -- exercise the real reality-check broker round trip with zero writes to the target repo",
    goal="Use the Amplifier Resolve reality-check broker API to independently confirm, inside a real Incus-provisioned DTU, a fact that is already true about a target GitHub repo's current default-branch state -- with no push or write access required.",
    rankdir=LR,
    default_max_retry=1,
    default_fidelity="truncate",
    model_stylesheet="* { llm_model: claude-sonnet-4-6; llm_provider: anthropic; }"
  ];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  // -- Node 1: build the reality-check inputs. NO write, NO push, NO commit. --
  //
  // Same software_path normalisation as reality_check_smoke.dot's
  // PrepareRealityCheckInputs (http*/owner-name-shorthand -> full URL,
  // sourced from $REPO). The acceptance spec is GENERIC and validates repo
  // state that already exists -- it never reads back anything this pipeline
  // wrote, because this pipeline writes nothing. An optional $SPEC context
  // var (tool_env) lets a caller override the default criteria with their
  // own already-true claim about their own target repo.
  PrepareRealityCheckInputs [
    shape=parallelogram, label="Prepare Reality Check Inputs",
    tool_env="repo,spec",
    tool_command="#!/bin/sh\nset -e\nmkdir -p .resolve/reality_check\ncat > /tmp/rc_smoke_ro_prepare_inputs.py <<'PYEOF'\nimport json\nimport os\nimport pathlib\nimport sys\n\nrepo_slug = (os.environ.get('REPO') or '').strip()\nif repo_slug.startswith('http'):\n    software_path = repo_slug\nelse:\n    software_path = 'https://github.com/' + repo_slug\n\nartifact_path = pathlib.Path('.resolve/reality_check/artifact.json')\nartifact_path.parent.mkdir(parents=True, exist_ok=True)\nartifact_path.write_text(json.dumps({'software_path': software_path}))\n\nconfig_path = pathlib.Path('/project/.resolve/config.json')\ncfg = json.loads(config_path.read_text()) if config_path.exists() else {}\ncfg.setdefault('params', {})\n\nnl = chr(10)\ndefault_spec = (\n    'Clone the repository default branch. No content was written or pushed ' + nl +\n    'to this repository by this pipeline or anything upstream of this ' + nl +\n    'check -- you are inspecting whatever already exists on the default ' + nl +\n    'branch. Confirm that the clone succeeded, the working tree is ' + nl +\n    'non-empty, and a file named README.md exists at the repository root ' + nl +\n    'with non-empty content. Pass if and only if all of those hold. Fail ' + nl +\n    'otherwise. No deployment or server startup is required -- this is a ' + nl +\n    'pure filesystem check against the freshly cloned repository.'\n)\n\noverride_spec = (os.environ.get('SPEC') or '').strip()\ncfg['params']['spec'] = override_spec or default_spec\nconfig_path.write_text(json.dumps(cfg, indent=2))\n\nprint('artifact.json software_path=' + software_path, file=sys.stderr)\nprint('rc spec set: ' + cfg['params']['spec'], file=sys.stderr)\nprint('artifact_ready')\nPYEOF\n/opt/uv-tools/amplifier/bin/python /tmp/rc_smoke_ro_prepare_inputs.py"
  ];

  // -- Node 2: the real broker call -- VERBATIM reuse, unchanged --------------
  //
  // Identical to reality_check_smoke.dot's RealityCheck node (itself a
  // verbatim copy of the proven reference in reality_check.dot). See that
  // pipeline's header comment for the full provenance trail.
  RealityCheck [
    shape=parallelogram, label="Reality Check",
    tool_command="#!/bin/sh\nset -e\n# Live SDK invocation. See handlers/reality_check_invoke.py for the\n# real implementation; this just dispatches to it via the SDK-enabled\n# Python interpreter (system python3 lacks aiohttp + amplifier-resolver-sdk).\n#\n# Requires AMPLIFIER_RESOLVE_ENABLE_REALITY_CHECK=true on the resolve\n# backend. If that flag is unset (or any other infrastructure precondition\n# fails -- SDK missing, broker unreachable, runner image missing, etc.)\n# the invoker exits non-zero and this node fails. NO synthetic fallback.\nmkdir -p .resolve/reality_check\n/opt/uv-tools/amplifier/bin/python -m amplifier_resolver_dot_graph.handlers.reality_check_invoke\nprintf 'reality_check_complete'"
  ];

  // -- Node 3: render + route on the verdict -- IDENTICAL to reality_check_smoke.dot
  RenderVerdict [
    shape=parallelogram, label="Render Verdict",
    tool_command="#!/bin/sh\nset -e\nmkdir -p .resolve/reality_check\ncat > /tmp/rc_smoke_ro_render_verdict.py <<'PYEOF'\nimport json\nimport pathlib\nimport sys\n\nverdict_path = pathlib.Path('.resolve/reality_check/verdict.json')\nif verdict_path.exists():\n    v = json.loads(verdict_path.read_text())\nelse:\n    v = {}\n\nverdict = v.get('verdict')\nstatus = v.get('status') or 'unknown'\nfailure_mode = v.get('failure_mode')\nsession_id = v.get('session_id') or 'n/a'\nreport_yaml_path = v.get('report_yaml_path') or 'n/a'\nsmoke_result = 'passed' if verdict == 'pass' else 'failed'\n\nnl = chr(10)\nout_dir = pathlib.Path('.reality-check-smoke')\nout_dir.mkdir(parents=True, exist_ok=True)\nlines = [\n    '# Reality-check smoke verdict (read-only)',\n    '',\n    '- Session: ' + str(session_id),\n    '- Status: ' + str(status),\n    '- Verdict: ' + str(verdict),\n    '- Failure mode: ' + str(failure_mode),\n    '- Report: ' + str(report_yaml_path),\n    '- Smoke result: ' + smoke_result,\n]\n(out_dir / 'verdict.md').write_text(nl.join(lines) + nl)\n\nprint('rendered verdict: smoke_result=' + smoke_result + ' rc_verdict=' + str(verdict), file=sys.stderr)\nprint(json.dumps({\n    'rc.verdict': str(verdict),\n    'rc.status': status,\n    'rc.failure_mode': str(failure_mode),\n    'rc.session_id': session_id,\n    'smoke.result': smoke_result,\n}))\nPYEOF\n/opt/uv-tools/amplifier/bin/python /tmp/rc_smoke_ro_render_verdict.py",
    parse_json="true"
  ];

  // Plain narration only -- no goal_gate, nothing downstream depends on this
  // node's own judgment (Report -> Exit is unconditional).
  Report [
    shape=box, fidelity="summary:high",
    label="Report",
    prompt="Report the final outcome of this READ-ONLY reality-check smoke test plainly, in one short paragraph. This run never wrote, committed, or pushed anything to the target repository -- it only asked reality-check to independently confirm a fact that was already true about the repo's current default-branch state. If ${smoke.result} is 'passed', state that a live Amplifier Resolve reality-check run (session ${rc.session_id}) confirmed the repository's existing state met the acceptance criteria. If ${smoke.result} is anything other than 'passed', state plainly that the smoke test failed and report why: rc.failure_mode=${rc.failure_mode}, rc.status=${rc.status}, rc.verdict=${rc.verdict}. Do not claim success unless smoke.result is exactly 'passed'. Print the single line: reported"
  ];

  Start                     -> PrepareRealityCheckInputs;
  PrepareRealityCheckInputs -> RealityCheck;
  RealityCheck              -> RenderVerdict;
  RealityCheck              -> RenderVerdict [condition="outcome=fail"];  // safety net: invoker crashed outright rather than writing a failure verdict; RenderVerdict handles a missing verdict.json gracefully
  RenderVerdict             -> Report;
  Report                    -> Exit;
}
