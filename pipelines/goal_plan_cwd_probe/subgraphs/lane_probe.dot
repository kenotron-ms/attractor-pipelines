// lane_probe.dot
//
// The first deterministic tool records its inherited CWD, resolves this lane's
// assigned target from the pre-fan-out state file, and updates only the cloned
// branch context. The box prompt receives relative artifact names, never the
// assigned absolute target, so it cannot conceal the session CWD chosen by the
// engine. Tool controls before and after the box independently demonstrate the
// context.target_dir behavior.

digraph lane_probe {
    graph [
        label="Single Lane CWD Probe",
        goal="Record the engine-established box session CWD without changing directories",
        params="probe_python, probe_script, probe_state, lane_id, pwd_artifact, sentinel_artifact, sentinel_payload",
        default_fidelity="full"
    ]

    node [fontname="Helvetica", fontsize=11]
    edge [fontname="Helvetica", fontsize=10]

    Start [shape=Mdiamond, label="Start Lane"]

    BindTarget [
        shape=parallelogram,
        label="Bind Lane Target",
        timeout="1m",
        parse_json="true",
        tool_command="\"$probe_python\" \"$probe_script\" bind-target --state \"$probe_state\" --lane \"$lane_id\""
    ]

    RecordToolBefore [
        shape=parallelogram,
        label="Record Tool CWD Before Box",
        timeout="1m",
        tool_command="\"$probe_python\" \"$probe_script\" record-control --state \"$probe_state\" --scope \"$lane_id\" --phase before-box"
    ]

    BoxProbe [
        shape=box,
        label="Real Box Session CWD Probe",
        llm_provider="anthropic",
        llm_model="claude-haiku-4-5",
        timeout="4m",
        max_agent_turns="4",
        prompt="This is an engine working-directory probe. Use the bash tool exactly once. Do not call cd, chdir, pushd, or popd. Do not use an absolute path. In that one bash call: (1) run `pwd -P` and capture its stdout; (2) write that exact stdout plus one newline to the relative file `$pwd_artifact`; (3) write the exact token `$sentinel_payload` plus one newline to the relative file `$sentinel_artifact`; and (4) print the observed pwd. Do not inspect parent directories or choose a destination: the engine-established current directory is the subject of the probe. Do not create any other file. After the bash call succeeds, respond with exactly {\"status\":\"success\"}."
    ]

    RecordToolAfter [
        shape=parallelogram,
        label="Record Tool CWD After Box",
        timeout="1m",
        tool_command="\"$probe_python\" \"$probe_script\" record-control --state \"$probe_state\" --scope \"$lane_id\" --phase after-box"
    ]

    Done [shape=Msquare, label="Lane Probe Complete"]

    Start -> BindTarget -> RecordToolBefore -> BoxProbe -> RecordToolAfter -> Done
}