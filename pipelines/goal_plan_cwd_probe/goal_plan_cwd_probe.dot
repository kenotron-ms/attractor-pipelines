// goal_plan_cwd_probe.dot
//
// Infrastructure probe, intentionally acyclic: the box nodes are the subject
// under test, while an external deterministic verifier classifies their actual
// filesystem effects. A component/folder fan-out gives each lane an isolated
// branch context before lane_probe.dot binds context.target_dir.

digraph goal_plan_cwd_probe {
    graph [
        label="Goal Plan Concurrent Lane CWD Probe",
        goal="Observe whether concurrent folder-lane box sessions honor distinct lane worktree working directories",
        params="probe_python, probe_script, probe_root, probe_state",
        default_fidelity="full"
    ]

    node [fontname="Helvetica", fontsize=11]
    edge [fontname="Helvetica", fontsize=10]

    Start [shape=Mdiamond, label="Start"]

    PrepareTargets [
        shape=parallelogram,
        label="Prepare Fresh Git Root + Lane Worktrees",
        timeout="2m",
        parse_json="true",
        tool_command="\"$probe_python\" \"$probe_script\" prepare --run-root \"$probe_root\" --state \"$probe_state\""
    ]

    LaneFanOut [
        shape=component,
        label="Concurrent Lane Fan-Out",
        max_parallel="2",
        join_policy="wait_all",
        error_policy="continue"
    ]

    LaneA [
        shape=folder,
        label="Lane A",
        dot_file="subgraphs/lane_probe.dot",
        "context.lane_id"="lane-a"
    ]

    LaneB [
        shape=folder,
        label="Lane B",
        dot_file="subgraphs/lane_probe.dot",
        "context.lane_id"="lane-b"
    ]

    LaneFanIn [
        shape=tripleoctagon,
        label="Deterministic Lane Fan-In"
    ]

    RecordParentControl [
        shape=parallelogram,
        label="Record Parent Tool CWD",
        timeout="1m",
        tool_command="\"$probe_python\" \"$probe_script\" record-control --state \"$probe_state\" --scope parent --phase after-fan-in"
    ]

    Done [shape=Msquare, label="Probe Run Complete"]

    Start -> PrepareTargets -> LaneFanOut

    LaneFanOut -> LaneA
    LaneFanOut -> LaneB

    LaneA -> LaneFanIn
    LaneB -> LaneFanIn

    LaneFanIn -> RecordParentControl -> Done
}