// goal_plan_convergence_probe.dot
//
// A bounded, evidence-gated correction probe:
//   deterministic invalid seed -> external verifier FAIL -> bounded feedback
//   -> real adaptive box correction -> external verifier PASS
//   -> separate parent re-verification -> sole success token -> exit.
//
// The verifier runner is a deterministic classifier around
// scripts/verify_candidate.py. The child verifier's real exit code is preserved
// in run_state/verifier_history.json while the classifier emits safe routing
// tokens with exit 0. This avoids routing on stale tool.last_line after a failed
// tool node. Candidate attempts are counted atomically and capped at three.

digraph goal_plan_convergence_probe {
    graph [
        goal="Converge a deterministically invalid candidate only through external verification, bounded feedback, adaptive correction, and independent parent re-verification",
        rankdir=LR,
        default_max_retries=0,
        default_fidelity="compact",
        max_pipeline_duration="1800s"
    ]

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    reset [
        shape=parallelogram,
        label="Reset + Seed Invalid Attempt 1",
        tool_command="python3 scripts/reset_probe.py"
    ]

    verify_candidate [
        shape=parallelogram,
        label="External Candidate Verifier",
        tool_command="python3 scripts/run_candidate_verifier.py"
    ]

    prepare_attempt [
        shape=parallelogram,
        label="Reserve Next Candidate Attempt (max 3)",
        tool_command="python3 scripts/prepare_attempt.py"
    ]

    correct_candidate [
        shape=box,
        label="Adaptive Correction Worker",
        llm_provider="anthropic",
        llm_model="claude-sonnet-4-6",
        thread_id="candidate-correction",
        fidelity="full",
        feedback_from="verify_candidate",
        prompt="Advance the candidate toward the externally verified predicate. Read candidate.txt, run_state/current_feedback.json, and run_state/attempt_state.json before acting. The feedback file is durable output derived from the external verifier's observed failure. The engine also injects the bounded verifier channel here:\n$prior_critiques_correct_candidate\n\nModify ONLY candidate.txt. Do not edit scripts, DOT, run_state, artifacts, or evidence. Overwrite candidate.txt with exactly these two UTF-8 lines, including the final newline:\nstatus=valid\nfeedback_ack=EXTERNAL_VERIFIER_REQUIRES_VALID_STATUS\n\nUse a real file-writing tool, then reread candidate.txt. Do not run or modify the verifier and do not claim PASS; only the external verifier and later parent verifier may decide success."
    ]

    parent_verify [
        shape=parallelogram,
        label="Independent Parent Re-Verification",
        tool_command="python3 scripts/parent_verify.py"
    ]

    fail_unexpected_seed [
        shape=parallelogram,
        label="FAIL: Seed Did Not Fail",
        max_retries=0,
        runs_on="always",
        tool_command="python3 scripts/write_terminal.py FAIL_INITIAL_CANDIDATE_DID_NOT_FAIL"
    ]

    fail_budget [
        shape=parallelogram,
        label="FAIL: Candidate Budget Exhausted",
        max_retries=0,
        runs_on="always",
        tool_command="python3 scripts/write_terminal.py FAIL_CANDIDATE_ATTEMPT_BUDGET_EXHAUSTED"
    ]

    fail_parent [
        shape=parallelogram,
        label="FAIL: Parent Re-Verification",
        max_retries=0,
        runs_on="always",
        tool_command="python3 scripts/write_terminal.py FAIL_PARENT_REVERIFICATION"
    ]

    fail_infra [
        shape=parallelogram,
        label="BLOCKED: Infrastructure",
        max_retries=0,
        runs_on="always",
        tool_command="python3 scripts/write_terminal.py BLOCKED_VERIFICATION_INFRASTRUCTURE"
    ]

    start -> reset

    reset -> verify_candidate [
        condition="context.tool.last_line=RESET:OK && outcome=success",
        label="invalid attempt 1 seeded"
    ]
    reset -> fail_infra [condition="context.tool.last_line=RESET:INFRA && outcome=success"]
    reset -> fail_infra [condition="outcome=fail"]

    // Initial PASS is a probe failure: attempt 1 is required to fail externally.
    verify_candidate -> fail_unexpected_seed [
        condition="context.tool.last_line=CANDIDATE_VERIFY:UNEXPECTED_INITIAL_PASS && outcome=success",
        label="unexpected seed pass"
    ]
    verify_candidate -> prepare_attempt [
        condition="context.tool.last_line=CANDIDATE_VERIFY:FAIL && outcome=success",
        label="observed external failure"
    ]
    verify_candidate -> fail_infra [
        condition="context.tool.last_line=CANDIDATE_VERIFY:INFRA && outcome=success"
    ]
    verify_candidate -> fail_infra [condition="outcome=fail"]

    // loop_restart causes feedback_from=verify_candidate to collect the
    // classifier's bounded feedback before node outcomes are cleared.
    prepare_attempt -> correct_candidate [
        condition="context.tool.last_line=CORRECTION:READY && outcome=success",
        loop_restart="true",
        fidelity="full",
        label="bounded feedback + next adaptive attempt"
    ]
    prepare_attempt -> fail_budget [
        condition="context.tool.last_line=CORRECTION:EXHAUSTED && outcome=success",
        label="three total candidates consumed"
    ]
    prepare_attempt -> fail_infra [
        condition="context.tool.last_line=CORRECTION:INFRA && outcome=success"
    ]
    prepare_attempt -> fail_infra [condition="outcome=fail"]

    correct_candidate -> verify_candidate [
        condition="outcome=success",
        label="candidate changed; verifier decides"
    ]
    correct_candidate -> fail_infra [condition="outcome=fail"]

    // Corrected FAILs return through prepare_attempt, which either reserves the
    // next bounded attempt or routes to the evidence-bearing budget terminal.
    // Corrected PASS is still not graph success: parent verification must rerun.
    verify_candidate -> parent_verify [
        condition="context.tool.last_line=CANDIDATE_VERIFY:PASS && outcome=success",
        label="child convergence candidate"
    ]

    parent_verify -> exit [
        condition="context.tool.last_line=CONVERGENCE_PROBE:PASS && outcome=success",
        label="sole success route"
    ]
    parent_verify -> fail_parent [
        condition="context.tool.last_line=PARENT_VERIFY:FAIL && outcome=success"
    ]
    parent_verify -> fail_infra [
        condition="context.tool.last_line=PARENT_VERIFY:INFRA && outcome=success"
    ]
    parent_verify -> fail_infra [condition="outcome=fail"]

    // Loud evidence-bearing terminals carry a genuine nonzero outcome into the
    // single exit. No failure route can reach the parent-token success edge.
    fail_unexpected_seed -> exit [condition="outcome=fail"]
    fail_budget -> exit [condition="outcome=fail"]
    fail_parent -> exit [condition="outcome=fail"]
    fail_infra -> exit [condition="outcome=fail"]
}