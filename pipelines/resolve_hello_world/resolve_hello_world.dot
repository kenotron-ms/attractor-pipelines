// resolve_hello_world.dot
//
// Resolve-platform-flavored sibling of pipelines/hello_world/hello_world.dot.
// Same minimal shape (write -> commit/push -> open PR), but this variant is
// deliberately NOT portable across engines -- it leans on Amplifier Resolve
// platform mechanism as much as possible instead of staying engine-agnostic:
//
//   - Clone: NOT a pipeline step. Driven by the standard `repo_url`
//     instantiation param every dot-graph resolver pipeline gets for free,
//     resolved via the resolver's workspace_spec() before Start ever fires.
//   - Migrate to Gitea: NOT a pipeline step. workspace_spec() requests a
//     Gitea sidecar for the instance; the platform mirrors the target repo
//     into it before the worker container starts. By the time WriteHelloWorld
//     runs, `origin` already points at the Gitea mirror, not upstream GitHub.
//   - PR delivery: uses the platform's provider-agnostic
//     /usr/local/bin/create-pr script (injected into every worker container
//     by amplifier-resolve's git_provider.py) instead of raw `gh`/`curl`.
//     It resolves GitHub-vs-Gitea destination and auth (GitHub App
//     installation token first, PAT fallback) from the container's
//     GIT_PROVIDER / GIT_PROVIDER_HOST env -- this pipeline never touches
//     credentials directly.
//
// Use pipelines/hello_world/hello_world.dot instead if you need this pipeline
// to run outside an Amplifier Resolve worker container (create-pr will not
// exist there).
//
// Context inputs:
//   $repo   - target repo slug (owner/name), same convention as hello_world.
//
// Context outputs:
//   delivery.pr_url  - PR URL, set by DeliverPRResolve subgraph
//   delivery.result  - "opened" | "failed"
//
// Submitting this job correctly (REQUIRED for real PR delivery):
//
// PR delivery only works if the RESOLVE INSTANCE ITSELF is submitted with
// two specific instantiation params, on top of `repo_url` -- this is a
// platform-level requirement enforced by amplifier-resolve's
// POST /internal/instances/{id}/repos/{repo}/promote/pr endpoint, not
// something this pipeline can request after the instance is already
// running:
//
//   delivery_mode: "promote"
//     Without this, the promote/pr endpoint refuses with HTTP 409
//     "Promotion was not requested" (routes/internal.py).
//   branch_name: "resolve/<repo-name>-<first-8-chars-of-instance-id>"
//     Optional -- if omitted, the platform derives this exact value
//     itself as the expected branch. Supplying it explicitly is only
//     useful if you need to know the branch name before the instance
//     starts. If the branch actually pushed doesn't match this pattern
//     exactly, the endpoint 422s with "Promotion branch does not match
//     submitted instance."
//
// In natural language, correctly submitting this job looks like:
//
//   "Submit a dot-graph job using pipeline
//   git+https://github.com/kenotron-ms/attractor-pipelines@main#subdirectory=pipelines/resolve_hello_world/resolve_hello_world.dot,
//   against repo_url=<target-repo-https-url>, with delivery_mode=promote.
//   Let the platform derive branch_name itself unless you have a reason
//   to pin it."
//
// See resolve_hello_world.md (this folder) for the full walkthrough,
// worked examples, and exact remote.py / amplifier-resolve CLI
// invocations. This pipeline is meant to be the reference example for
// how a remote dot-graph pipeline delivers a real GitHub PR -- read that
// doc before adapting this pattern into a new pipeline.

digraph resolve_hello_world {
  graph [
    label="Resolve Hello World -- minimal write-a-file-and-open-a-PR demo via the Amplifier Resolve platform",
    goal="$repo",
    rankdir=LR,
    default_max_retry=2,
    default_fidelity="summary:high",
    model_stylesheet="* { llm_model: claude-sonnet-4-6; llm_provider: anthropic; }"
  ];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  // Deterministic tool node -- creates the branch and writes the file via
  // a real shell command, not LLM judgment.
  //
  // This was previously a `shape=box, goal_gate=true` LLM node whose prompt
  // only asked for a prose confirmation ("Print the single line:
  // hello_world_written"). Per the attractor engine's fail-closed goal-gate
  // contract (specs/EXTENSIONS.md Sec25; context/engine-semantics.md Sec5),
  // a goal_gate=true node MUST provide an explicit verdict (a
  // `report_outcome` call, JSON, or a tool node's own exit code) -- plain
  // prose falls through to the RETRY path no matter what it says. That LLM
  // node retried out (default_max_retry=2 => 3 attempts) and then hit the
  // "FAIL does not traverse plain edges" rule (engine-semantics.md Sec2
  // #2: WriteHelloWorld -> DeliverPRResolve was an unconditional edge),
  // producing PIPELINE_ERROR error_type=no_matching_edge -- observed
  // directly on a real staging run (instance 3c3689b633a8).
  //
  // Fixed by moving goal_gate onto a parallelogram/tool node whose exit
  // code IS the verdict (engine-semantics.md Sec5, the `is_explicit` rule),
  // using the canonical `cmd && printf ok || printf fail` idiom routed on
  // context.tool.last_line (engine-semantics.md Sec3). Literal shell `$` is
  // escaped as `$$` per the engine's own substitution rule (Sec4) so the
  // pipeline's variable-expansion pass doesn't touch it.
  WriteHelloWorld [
    shape=parallelogram, goal_gate=true,
    label="Write hello_world.txt",
    tool_command="BRANCH=hello-world-resolve-$$(date -u +%Y%m%d%H%M%S); git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git checkout -b \"$$BRANCH\" >/dev/null 2>&1; printf 'Hello, World!\n\nThis file was created by the resolve_hello_world pipeline in kenotron-ms/attractor-pipelines -- a minimal end-to-end demo that leans on the Amplifier Resolve platform (clone / Gitea-migrate / create-pr) mechanism as much as possible.\n' > hello_world.txt; test -f hello_world.txt && printf ok || printf fail"
  ];

  // Reuses the same shape=folder delegation pattern as hello_world.dot's
  // DeliverPR, but the subgraph itself swaps the portable gh/curl delivery
  // mechanism for the platform's create-pr script.
  DeliverPRResolve [
    shape=folder, label="Deliver PR (via platform create-pr)",
    dot_file="subgraphs/deliver_pr_resolve.dot",
    outputs="delivery.pr_url,delivery.result"
  ];

  // Plain reporting step -- no goal to gate here (nothing downstream
  // depends on this node's own verdict; Report -> Exit is unconditional),
  // so goal_gate is correctly omitted. Per engine-semantics.md Sec5,
  // ordinary (non-goal_gate) box nodes get SUCCESS on prose completion --
  // this node's prior goal_gate=true was the same misapplied pattern as
  // WriteHelloWorld's, just never reached by a real run (yet).
  Report [
    shape=box, fidelity="summary:high",
    label="Report",
    prompt="Report the outcome: if ${delivery.result} is 'opened', state the PR URL (${delivery.pr_url}) plainly. If it's 'failed', say so plainly and do not claim success."
  ];

  Start            -> WriteHelloWorld;
  WriteHelloWorld  -> DeliverPRResolve [condition="context.tool.last_line=ok"];
  WriteHelloWorld  -> Exit             [condition="context.tool.last_line=fail"];
  DeliverPRResolve -> Report [condition="context.delivery.result=opened", weight="2"];
  DeliverPRResolve -> Report [condition="context.delivery.result=failed"];
  Report           -> Exit;
}
