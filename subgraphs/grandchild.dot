// grandchild.dot -- Trivial leaf subgraph.
//
// Terminates the in-origin recursion chain (main -> child -> grandchild).
// No further dot_file= references -- this is the leaf.

digraph GrandchildSubgraph {
  graph [
    label="dot-graph-samples -- Grandchild Subgraph (leaf)",
    rankdir=LR,
    default_fidelity="truncate"
  ];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  MarkGrandchildReached [
    shape=parallelogram,
    label="Mark Grandchild Reached",
    tool_command="printf 'grandchild_reached'"
  ];

  Start -> MarkGrandchildReached;
  MarkGrandchildReached -> Exit;
}
